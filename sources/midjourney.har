red reference{count, plural, one { is} other {s are}} missing.\",\"info.weird.droppedForMoodboard\":\"Weird has been reset to 0 because it is not compatible with moodboards.\",\"info.weird.ignoredForMoodboard\":\"Weird will be ignored for this job because it is not compatible with moodboards.\",\"toast.report.loading\":\"Reporting...\",\"toast.report.success\":\"Reported\",\"toast.report.error\":\"Something went wrong, please try again.\",\"toast.copySeed.loading\":\"Copying seed...\",\"toast.copySeed.success\":\"Seed copied\",\"toast.copySeed.error\":\"Couldn't copy seed.\",\"toast.rerunHd.loading\":\"Re-running with HD...\",\"toast.rerunHd.success\":\"Job submitted\",\"toast.rerunHd.error\":\"Couldn't re-run with HD.\",\"toast.fetchDiscordId.loading\":\"Fetching Discord ID...\",\"toast.fetchDiscordId.success\":\"Discord ID copied\",\"toast.fetchDiscordId.error\":\"Error fetching Discord ID\",\"toast.copyImage.loading\":\"Copying image...\",\"toast.copyImage.success\":\"Image copied\",\"toast.copyImage.error\":\"Couldn't copy image\",\"toast.fetchDiscordUrl.loading\":\"Fetching Discord URL...\",\"toast.fetchDiscordUrl.success\":\"Discord URL opened\",\"toast.fetchDiscordUrl.error\":\"Job was not found on Discord\",\"toast.devNotify.loading\":\"Notifying developers...\",\"toast.devNotify.success\":\"Developers have been notified.\",\"toast.devNotify.error\":\"Failed to notify developers.\",Del:\"Del\",Enter:\"Enter\",Select:\"Select\",\"1\":\"1\",\"2\":\"2\",\"4\":\"4\",\"error.video.copyFrameFailed\":\"Failed to copy video frame\",\"error.copyImage.failed\":\"Failed to copy image to clipboard\",\"error.invalid-temperature\":\"Invalid temperature value: {status}\",\"error.invalid-filter-top-percent\":\"Invalid filter percentage: {status}\",\"error.unableToSaveToLocalStorage\":\"Unable to save to local storage\",\"Mini Plan (view details in app)\":\"Mini Plan (view details in app)\",\"Limited generations (~80 / month)\":\"Limited generations (~80 / month)\",\"3 concurrent Fast jobs\":\"3 simultaneous Fast jobs\",Enterprise:\"Enterprise\",\"50 seat minimum\":\"50 seat minimum\",\"Priority support\":\"Priority support\",\"Enterprise billing options\":\"Enterprise billing options\",\"meta.tasks.title\":\"Tasks\",\"meta.tasks.description\":\"Tasks\",\"meta.updates.description\":\"The latest news and updates from Midjourney: new model versions, video tools, updates, releases, and more.\",\"meta.surveys.title\":\"Surveys\",\"meta.surveys.description\":\"Answer surveys\",\"surveys.typeToSelect\":\"Type to select...\",\"meta.style.title\":\"Style\",\"meta.style.description\":\"Style\",\"meta.sharedSignin.title\":\"Verifying authentication\",\"meta.sharedSignin.description\":\"Please wait while we verify your authentication\",\"meta.image.title\":\"Image\",\"meta.image.description\":\"Image\",\"meta.ideas.title\":\"Ideas\",\"meta.ideas.description\":\"What should Midjourney work on?\",\"meta.verifyEmail.title\":\"Verify Email\",\"meta.verifyEmail.description\":\"Verify Email\",\"meta.signInOptions.title\":\"Sign-in options\",\"meta.signInOptions.description\":\"Sign-in options\",\"meta.yourProfile.title\":\"Your Profile\",\"meta.yourProfile.description\":\"View your images in the Midjourney public channels and DMs\",\"meta.moodboard.titleWithId\":\"Moodboard: {id}\",\"meta.moodboard.titleWithName\":\"Moodboard: {name}\",\"meta.moodboard.description\":\"Curate custom models with collections of images.\",\"meta.signIn.title\":\"Log In\",\"meta.signIn.description\":\"Sign up or log in to Midjourney\",\"common.other\":\"Other\",\"common.openOptions\":\"Open Options\",\"common.searchImage\":\"Search Image\",\"common.toggleInfo\":\"Toggle Info\",\"common.closeLightbox\":\"Close Lightbox\",\"common.jumpToTop\":\"Jump to the Top\",\"app.editor\":\"Editor\",\"editor.retextured\":\"Retextured\",\"editor.removeJob\":\"Remove Job\",\"editor.deleteLayer\":\"Delete Layer\",\"editor.scaledLargerThan100BlurryTooltip\":\"Images that are scaled larger than 100% may end up looking blurry\",\"editor.debugSession\":\"Debug Session\",\"styles.viewStyleInLightbox\":\"View style in lightbox\",\"styles.likeStyle\":\"Like Style\",\"styles.unlikeStyle\":\"Unlike Style\",\"manageSub.fastHoursDetails\":\"Fast Hours Details\",\"contextMenu.actionRunCount\":\"You've run this action {count, plural, one {# time} other {# times}}\",\"mcp.scope.mediaCreate\":\"Generate images using Midjourney\",\"mcp.scope.mcpAccess\":\"Access Midjourney via MCP\",\"mcp.consent.invalidRequest\":\"Invalid Request\",\"mcp.consent.invalidRequestDescription\":\"This authorization request is missing required parameters.\",\"mcp.consent.signInRequired\":\"Sign In Required\",\"mcp.consent.signInRequiredDescriptionPrefix\":\"You must be signed in to authorize\",\"mcp.consent.signInRequiredDescriptionSuffix\":\"to access your Midjourney account.\",\"mcp.consent.goToSignIn\":\"Go to Sign In\",\"mcp.consent.authorize\":\"Authorize\",\"mcp.consent.signedInAs\":\"Signed in as\",\"mcp.consent.wouldLikeTo\":\"would like to:\",\"mcp.consent.deny\":\"Deny\",\"mcp.consent.allow\":\"Allow\",\"mcp.consent.authorizing\":\"Authorizing...\",\"mcp.consent.disclaimerPrefix\":\"By authorizing, you allow\",\"mcp.consent.disclaimerSuffix\":\"to perform actions on your behalf.\"},uQ=op1;var tp1={...uQ,\"rooms.noLongerAvailable\":\"Roomsは廃止されました。\",\"rooms.buildingSomethingBetter\":\"より良いものを開発中です。<link>詳しくはこちら</link>\",\"gallery.learnMore\":\"もっと詳しく知りたいですか？<link>はじめにガイドをお読みください。</link>\",\"gallery.unauthedDemoClickToExpand\":\"クリックして拡大\",\"app.yesterday\":\"昨日\",\"app.twoDaysAgo\":\"一昨日\",\"nav.home\":\"ホーム\",\"nav.archive\":\"アーカイブ\",\"nav.help\":\"ヘルプ\",\"app.manageSubscription\":\"サブスクリプションの管理\",\"app.personalize\":\"パーソナライズ\",\"app.moodboards\":\"ムードボード\",\"app.termsOfService\":\"利用規約\",\"nav.signIn\":\"サインイン\",\"nav.signInWithDiscord\":\"Discordでサインイン\",\"nav.signOut\":\"サインアウト\",\"settings.title\":\"設定\",\"manageSub.purchaseASub\":\"サブスクリプションを購入する\",\"manageSub.yearlyBilling\":\"年額課金\",\"manageSub.monthlyBilling\":\"月額課金\",\"manageSub.chooseThePlan\":\"ご自分に合ったプランをお選びください。\",\"manageSub.subscribe\":\"サブスクライブ\",\"manageSub.unavailable\":\"使用不可\",\"manageSub.uncancelPlan\":\"解約予約を取り消す\",\"manageSub.cancelPlan\":\"解約する\",\"manageSub.disabledForMaintenance\":\"メンテナンスのため使用不可\",\"manageSub.switchToMonthlyBilling\":\"月額課金への切り替え\",\"manageSub.saveWithAnnualBilling\":\"年額課金でお得（{discount}％OFF）\",\"manageSub.billedYearly\":\"年額課金\",\"manageSub.billedMonthly\":\"月額課金\",\"manageSub.perMonth\":\"/ 月\",\"manageSub.perYear\":\"/ 年\",\"manageSub.plan\":\"Plan\",\"manageSub.yourPlan\":\"あなたの <highlight>{tier} プラン</highlight>\",\"manageSub.manage\":\"管理\",\"manageSub.fastHours\":\"Fast Hours\",\"manageSub.included\":\"含む\",\"manageSub.rollover\":\"繰り越し\",\"manageSub.buyMoreFastHours\":\"Fast hoursをもっと買う\",\"manageSub.temporarilyUnavailable\":\"一時的に使用不可\",\"manageSub.planFeatures\":\"プラン機能\",\"manageSub.stealthModeAddon\":\"ステルスモードアドオン\",\"info.settings.stealthDisabledForPlan\":\"プランにステルスが含まれていないため、ステルスをオフにしました。\",\"manageSub.remove\":\"取り除く\",\"manageSub.billingAndPayment\":\"請求と支払い\",\"manageSub.price\":\"価格\",\"manageSub.billingPeriod\":\"請求期間\",\"manageSub.annual\":\"年間\",\"manageSub.monthly\":\"月別\",\"manageSub.cancellingOn\":\"解約日\",\"manageSub.renewalDate\":\"更新日\",\"manageSub.changingOn\":\"変更\",\"manageSub.availableBalance\":\"利用可能残高\",\"manageSub.whatIsAvailableBalance.q\":\"利用可能残高はなんですか？\",\"manageSub.whatIsAvailableBalance.a\":\"特定のプラン変更（例：アドオンの削除）により、クレジット残高がプラスになる場合があります。この残高は、将来の料金の支払いに充当されます。\",\"manageSub.editBilling\":\"支払い編集\",\"manageSub.viewInvoices\":\"請求書を見る\",\"faq.title\":\"よくある質問\",\"faq.description\":\"お探しの答えが見つからない場合、{br}<guide>Quick Start Guide</guide>を確認するか<support>#質問</support>チャンネルにお問い合わせください。\",\"faq.whatAreFastHours.q\":'\"Fast Hours\"はなんですか？',\"faq.whatAreFastHours.a.0\":\"画像生成には「fast」と「relax」の2つのモードがあります。「fast」モードでは、画像生成するためのGPUを優先的に確保し、すぐに生成計算を始めることができ、また、こちらのモードでの優先順位が最も高いため、利用料金も高めに設定しております。「relax」モードでは、ご自身の利用状況に応じ、他のユーザーからのリクエストを優先して処理する可能性があります。\",\"faq.whatAreFastHours.a.1\":\"「ベーシック」プランでは200分/月、「スタンダード」プランでは15時間/月、「スタンダード」プランでは15時間/月、「プロ」プランでは30時間/月の「fast」モードでの生成計算時間を提供しています。\",\"faq.whatAreFastHours.a.2\":\"1時間の計算量で、画像生成やアップスケールコマンド約60個、もしくは画像バリエーションコマンド約200個を実行することができます。\",\"faq.whatAreFastHours.a.3\":\"この数値は実験的なものであり、随時変更される可能性があります。\",\"faq.whatIsUnlimitedRelaxed.q\":\"「relax」モードでの無制限生成はなんですか？\",\"faq.whatIsUnlimitedRelaxed.a.0\":\"「スタンダード」プランと「プロ」プランには「relax」モードを含まれています。 /relax と入力すれば「relax」モードに切り替わります。/fast と入力すれば「relax」モードから「fast」モードに戻せます。「relax」モードでの画像生成は「fast」モードの計算時間としてカウントされていません。\",\"faq.whatIsUnlimitedRelaxed.a.1\":\"ご注意：「ベーシック」プランには、「relax」モードは含まれていません。'Max Upscale 'は「relax」モードではご利用いただけません。\",\"faq.whatIfIWantMoreFast.q\":\"「fast」モードをもっと使いたい場合は？\",\"faq.whatIfIWantMoreFast.a.0\":\"Rollover Fast Hours can be bought in addition to your plan. They have no expiration date, but require an active subscription to use.\",\"faq.whatIsTheCommunityGallery.q\":\"コミュニティギャラリーとは？\",\"faq.whatIsTheCommunityGallery.a\":\"メンバーギャラリーでは有料会員がユーザー達が制作した画像を閲覧できます。また、自分の画像を整理することや、気になった画像を探すことなどの管理機能も含まれています。\",\"faq.whatIfIDontWantMyImages.q\":\"自分の画像をギャラリーに表示したくない場合はどうすればよいですか？\",\"faq.whatIfIDontWantMyImages.a.0\":\"私たちは、集団的な探求心と楽しさを中心にしたオープンコミュニティの構築を目指しています。もし、これと逆にステルスモードでの画像生成機能を必要とする場合には、月額60ドルの「プロ」プランを購読し、`/stealth`コマンドでステルス生成を有効にすることができます。\",\"faq.howDoesCommercialUseWork.q\":\"商用利用について\",\"faq.howDoesCommercialUseWork.a.0\":\"どの時点でも購読している場合は、画像をどのようにでも自由に使用することができます。\",\"faq.howDoesCommercialUseWork.a.1\":'詳細については、 <a href=\"https://docs.midjourney.com/hc/en-us/articles/32083055291277-Terms-of-Service\">利用規約</a>をご覧ください。',\"faq.canICancelMySubscriptionPlan.q\":\"サブスクリプションを解約することはできますか？\",\"faq.canICancelMySubscriptionPlan.a.0\":\"ユーザーはいつでも自由に解約することができますが、解約は現在の請求サイクルの終了時に有効となります。もし気が変わったら、サイクルが終わる前にプランのキャンセルを解除することができます。\",\"faq.canIChangeMySubscriptionPlan.q\":\"契約プランのアップグレードは可能ですか？\",\"faq.canIChangeMySubscriptionPlan.a.0\":\"ユーザーは、いつでも自由にプランをアップグレードすることができ、すぐに有効になります。残りの使用量や時間は、新しいプランに加算されます。\",\"common.back\":\"戻る\",\"common.next\":\"次へ\",\"common.tryAgain\":\"再試行\",\"common.success\":\"成功！\",\"common.error\":\"エラー\",\"common.loading\":\"読み込み中\",\"common.processing\":\"処理中...\",\"common.pleaseWait\":\"お待ちください\",\"common.somethingWentWrong\":\"何かがうまくいきませんでした :(\",\"common.changeConfirming\":\"変更確認中...\",\"common.changeConfirmed\":\"変更が確認されました\",\"common.confirmChange\":\"変更を確認\",\"common.planChangeSuccessful\":\"プラン変更が成功しました！ページを更新できます。\",basic:\"ベーシック\",standard:\"スタンダード\",pro:\"プロ\",\"Limited generations (~200 images / month)\":\"限定世代（月あたり約200枚の画像）\",\"General commercial terms\":\"一般向け商業契約\",\"Optional Fast hours top ups\":\"オプションでクレジットを追加購入\",\"15h Fast generations\":\"Fast Hours 15時間\",\"Unlimited Relax image generations\":\"Relaxモード無制限画像生成\",\"30h Fast generations\":\"Fast Hours 30時間\",\"Stealth mode generation\":\"ステルスモード生成\",\"200h Fast generations\":\"Fast Hours 200時間\",\"teach.rankings\":\"{count, plural, other {ポイント}}\",\"teach.pairs\":\"{count, plural, other {ポイント}}\",\"teach.rankingsThisSession\":\"今回のセッション：{count}ポイント\",\"rank.youHaveRankedMessage\":\"{numRankings}ポイント評価済み。{continueText}するには{minRankings}ポイント必要です。\",\"rank.countProgress\":\"{rankingCount} / {minRankingCount}ポイント\",\"imagePrompts.unsupportedVersion\":\"バージョン{version}ではまだ画像プロンプトに対応していません\",\"Enterprise commercial terms\":\"企業向け商用契約\"},Ce=tp1;var sp1={...uQ,\"rooms.noLongerAvailable\":\"Rooms는 더 이상 사용할 수 없습니다.\",\"rooms.buildingSomethingBetter\":\"더 나은 것을 만들고 있습니다. <link>자세히 알아보기</link>\",\"gallery.learnMore\":\"더 알아보고 싶으신가요? <link>시작하기 가이드를 읽어보세요.</link>\",\"gallery.unauthedDemoClickToExpand\":\"클릭하여 펼치기\",\"app.yesterday\":\"어제\",\"app.twoDaysAgo\":\"그저께\",\"teach.rankings\":\"{count, plural, other {포인트}}\",\"teach.pairs\":\"{count, plural, other {포인트}}\",\"teach.rankingsThisSession\":\"이번 세션: {count}포인트\",\"rank.youHaveRankedMessage\":\"{numRankings}포인트를 평가했습니다. {continueText}하려면 {minRankings}포인트가 필요합니다.\",\"rank.countProgress\":\"{rankingCount} / {minRankingCount}포인트\",\"imagePrompts.unsupportedVersion\":\"버전 {version}에서는 아직 이미지 프롬프트를 지원하지 않습니다\"},ye=sp1;var ep1={...uQ,\"home.meta.title\":\"Midjourney\",\"home.meta.description\":\"Ett oberoende forskningslabb som utforskar nya uttrycksformer för tankar och utökar människans kreativa möjligheter.\",\"nav.title\":\"Midjourney\",\"nav.shortTitle\":\"MJ\",\"nav.home\":\"Hem\",\"nav.profile\":\"Profil\",\"nav.explore\":\"Utforska\",\"nav.myAccount\":\"Mitt konto\",\"nav.edit\":\"Redigera\",\"nav.rankImages\":\"Betygsätt bilder\",\"nav.tasks\":\"Uppgifter\",\"nav.surveys\":\"Enkäter\",\"tasks.imageRankings\":\"Bildrankningar\",\"tasks.helpMakeMiddjourneyBetter\":\"Hjälp oss göra Midjourney bättre genom att ranka bilder\",\"tasks.rankVideos\":\"Betygsätt videor\",\"tasks.rankVideosDescription\":\"Bläddra bland en samling videor och välj dina favoriter. De 2 000 bästa rankarna varje dag får en extra snabb timme.\",\"tasks.earn\":\"Tjäna\",\"tasks.fast\":\"Snabb\",\"tasks.hours\":\"Timmar!\",\"tasks.curateCommunityFrontpage\":\"Kurera communityns förstasida\",\"tasks.curateCommunityFrontpageDescription\":\"Hjälp oss hitta de bästa bilderna till communityns förstasida. Detta ändrar inte din personalisering. De 2 000 bästa rankarna varje dag får en extra snabb timme.\",\"tasks.rankImageAesthetics\":\"Betygsätt bildestetik\",\"tasks.rankImageAestheticsDescription\":\"Bläddra bland bilder och välj dina favoriter. Att ranka bilder bygger också din personalisering. De 2 000 bästa rankarna varje dag får en extra snabb timme.\",\"tasks.rankImageAestheticsNiji\":\"Betygsätt bildestetik – Niji\",\"tasks.rankImageAestheticsNijiDescription\":\"Bläddra bland Niji-bilder och välj dina favoriter. Att ranka bilder bygger också din personalisering. De 2 000 bästa rankarna varje dag får en extra snabb timme.\",\"tasks.surveys\":\"Enkäter\",\"tasks.surveysDescription\":\"Dela med dig av tankar för att hjälpa oss utforska sambandet mellan personlighet och estetik.\",\"tasks.viewCompletedSurveys\":\"Visa slutförda enkäter\",\"tasks.viewCompletedSurveysDescription\":\"Se resultaten från tidigare personlighetstester och enkäter.\",\"tasks.completedSurveysLocked\":\"Slutför en enkät för att låsa upp dina resultat här.\",\"tasks.logInToTakeSurveys\":\"Logga in för att delta i enkäter\",\"tasks.community\":\"Community\",\"tasks.communityDescription\":\"Hjälp oss prioritera uppgifter för nästa generation av Midjourney.\",\"tasks.rateIdeas\":\"Betygsätt idéer\",\"tasks.rateIdeasDescription\":\"Hjälp Midjourney skapa en global topplista för funktioner. Tilldela poäng till funktioner som är viktiga för dig, bläddra bland toppidéer och skicka in egna förslag.\",\"lightbox.upscale\":\"Förstora\",\"lightbox.upscaled\":\"Förstorad\",\"lightbox.upscale.withSpace\":\"Förstora \",\"lightbox.event.label.imagine\":\"Föreställ\",\"lightbox.event.label.retexture\":\"Omtexturera\",\"lightbox.event.label.varyRegion\":\"Variera region\",\"lightbox.event.label.zoom\":\"Zooma\",\"lightbox.event.label.edit\":\"Redigera\",\"lightbox.event.label.pan\":\"Panorera\",\"lightbox.event.label.remix\":\"Remixa\",\"lightbox.event.label.reroll\":\"Rulla om\",\"lightbox.event.label.variation\":\"Variation\",\"lightbox.event.label.draft\":\"Utkast\",\"lightbox.event.label.enhance\":\"Förbättra\",\"lightbox.event.label.video\":\"Video\",\"lightbox.event.label.videoExtended\":\"Video förlängd\",\"lightbox.scale2x\":\"2x\",\"lightbox.scale4x\":\"4x\",\"lightbox.scaleSubtle\":\"(S)\",\"lightbox.scaleCreative\":\"(K)\",\"lightbox.newFolder\":\"Ny mapp\",\"common.default\":\"standard\",\"common.default.capitalized\":\"Standard\",\"prompt.thumbnails.imageNotFound\":\"Bilden hittades inte\",\"sidebar.addSearch\":\"Lägg till sökning\",\"sidebar.createProfile\":\"Skapa profil\",\"sidebar.profiles\":\"Profiler\",\"viewOptions.size\":\"Storlek\",\"creationButtons.actions\":\"Åtgärder\",\"creationButtons.editor\":\"Redigerare\",\"creationButtons.creation\":\"Skapande\",\"creationButtons.edit\":\"Rediger