ibility\":null,\"batchSize\":null,\"exp\":null,\"sd\":false,\"decodedPrompt\":[{\"content\":\"make an retro vintage picture not photo of a man and woman sitting on a dodge charger in teh 70's out in the orange desert with a space ship in the sky. The guy is laying down on his right elbow looking at his girl. he has shaggy medium length hair. Shes leaned back on both her elbows looking towards the spaceship sitting half lying down. Car should be orange\",\"weight\":1}],\"params\":null,\"version\":\"8.1\",\"quality\":null,\"tile\":false,\"styleRaw\":false,\"styleRef\":[],\"personalize\":[{\"content\":\"nubtenf\",\"weight\":1}],\"pv\":null,\"sv\":null,\"sw\":null,\"depthRef\":[],\"dw\":null,\"stylize\":null,\"weird\":550,\"imageWeight\":null,\"video\":false,\"draft\":false,\"hd\":true,\"preview\":false,\"av\":null},\"published\":true,\"items\":[{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":false}],\"owner_profile\":null,\"type\":\"image\",\"video_segments\":null},{\"isFeedJob\":true,\"id\":\"59d4ff41-0d37-4a71-bff8-424671b91b1b\",\"job_type\":\"v8-1_diffusion\",\"event_type\":\"diffusion\",\"enqueue_time\":1783888110588,\"parent_grid\":null,\"parent_id\":null,\"width\":928,\"height\":1232,\"username_v2\":\"scottxrt\",\"display_name\":\"scottxrt\",\"user_id\":\"72270a25-5f39-433e-881f-a1c7eb363a4b\",\"prompt\":{\"no\":[],\"images\":[],\"stop\":null,\"chaos\":null,\"ar\":{\"w\":3,\"h\":4},\"seed\":null,\"speed\":null,\"visibility\":null,\"batchSize\":null,\"exp\":null,\"sd\":false,\"decodedPrompt\":[{\"content\":\"Este prompt captura la esencia de su época dorada, mezclando la inocencia visual con el terror psicológico más crudo. Master Prompt: Professional 1970s horror manga illustration in the definitive style of Kazuo Umezu (Umezz). The subject is a character (child or young woman) with large, expressive shōjo eyes that feature iconic \\\"eye flares\\\" or star-like explosions in the pupils, conveying a moment of absolute psychological terror and self-realization. The artwork is characterized by intense manual cross-hatching and heavy, dense ink line-work that creates a claustrophobic and visceral atmosphere. Use a high-contrast chiaroscuro (clair-obscur) lighting scheme, casting deep, ink-heavy shadows against stark white highlights. The composition should feel like a frozen cinematic moment, with a focus on interiority and biological distress. Include hand-drawn, aggressive manga onomatopoeia integrated into the scene's texture. The color palette, if used, is vibrant but muted with a 70s\",\"weight\":1}],\"params\":null,\"version\":\"8.1\",\"quality\":null,\"tile\":false,\"styleRaw\":false,\"styleRef\":[],\"personalize\":false,\"pv\":null,\"sv\":null,\"sw\":null,\"depthRef\":[],\"dw\":null,\"stylize\":null,\"weird\":null,\"imageWeight\":null,\"video\":false,\"draft\":false,\"hd\":false,\"preview\":false,\"av\":null},\"published\":true,\"items\":[{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":false},{\"filtered\":false,\"actions\":{},\"server_filtered\":true}],\"owner_profile\":null,\"type\":\"image\",\"video_segments\":null},{\"isFeedJob\":true,\"id\":\"99d72a71-3c3d-4ad6-a94b-eed666970673\",\"job_type\":\"v8-1_hd_diffusion\",\"event_type\":\"variation\",\"enqueue_time\":1783869790012,\"parent_grid\":1,\"parent_id\":\"327ef890-4472-4e4c-9d78-bd32e94a662c\",\"width\":1904,\"height\":2544,\"username_v2\":\"lilianyang\",\"display_name\":\"lilianyang\",\"user_id\":\"038bfeeb-93e2-4cc0-91f4-58bc80af5097\",\"prompt\":{\"no\":[],\"images\":[],\"stop\":null,\"chaos\":15,\"ar\":{\"w\":3,\"h\":4},\"seed\":null,\"speed\":null,\"visibility\":null,\"batchSize\":null,\"exp\":50,\"sd\":false,\"decodedPrompt\":[{\"content\":\"high fashion editorial, elegant woman with slicked-back dark hair, oversized powder blue structured blazer with exaggerated shoulders, lime green opaque tights, matching lime green chunky platform mary jane heels, futuristic silver sunglasses, holographic oversized stars, , moon beams, and planets , elegant styling, soft colours, magical realism, cinematic photography\",\"weight\":1}],\"params\":null,\"version\":\"8.1\",\"quality\":null,\"tile\":false,\"styleRaw\":true,\"styleRef\":[{\"t\":\"seed\",\"content\":\"6531962495\",\"weight\":1}],\"personalize\":[{\"content\":\"8jr11hw\",\"weight\":1},{\"content\":\"w5tgviu\",\"weight\":1},{\"content\":\"g485zll\",\"weight\":1},{\"content\":\"at5lqfr\",\"weight\":1},{\"content\":\"2trx3l5\",\"weight\":1},{\"content\":\"9th9zcz\",\"weight\":1}],\"pv\":null,\"sv\":null,\"sw\":null,\"depthRef\":[],\"dw\":null,\"stylize\":90,\"weird\":null,\"imageWeight\":null,\"video\":false,\"draft\":false,\"hd\":true,\"preview\":true,\"av\":null},\"published\":true,\"items\":[{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":false}],\"owner_profile\":null,\"type\":\"image\",\"video_segments\":null},{\"isFeedJob\":true,\"id\":\"860d81aa-c13a-46ed-ba25-08026185adee\",\"job_type\":\"v8-1_diffusion\",\"event_type\":\"diffusion\",\"enqueue_time\":1783872231733,\"parent_grid\":null,\"parent_id\":null,\"width\":928,\"height\":1232,\"username_v2\":\"mirmin\",\"display_name\":\"mirmin\",\"user_id\":\"b9828a7e-477c-409c-9a85-98eead378c42\",\"prompt\":{\"no\":[],\"images\":[],\"stop\":null,\"chaos\":null,\"ar\":{\"w\":3,\"h\":4},\"seed\":null,\"speed\":null,\"visibility\":null,\"batchSize\":null,\"exp\":null,\"sd\":false,\"decodedPrompt\":[{\"content\":\"A cute, friendly monster. Detailed fur texture. front view. Pixar style 3D animation. white background.\",\"weight