vider}\",\"profileSettings.disconnect\":\"Disconnect\",\"profileSettings.disconnectProvider\":\"Disconnect {provider}\",\"profileSettings.disconnectProvider.confirm\":\"Please confirm that you want to disconnect your {provider} login.\",\"profileSettings.accountDetails.heading\":\"Account Details\",\"profileSettings.accountDetails.email\":\"Email\",\"profileSettings.accountDetails.midjourneyId\":\"Midjourney ID\",\"profileSettings.dataAndPrivacy.heading\":\"Data and Privacy\",\"profileSettings.userDataExport.heading\":\"Data Export\",\"profileSettings.userDataExport.description\":\"Currently includes your analytics data. Please visit the Organize page to manage media downloads.\",\"profileSettings.userDataExport.requestButton\":\"Request Export\",\"profileSettings.userDataExport.pending.title\":\"Export in progress\",\"profileSettings.userDataExport.pending.detail\":\"Requested {date}\",\"profileSettings.userDataExport.downloadButton\":\"Download your data\",\"profileSettings.userDataExport.expiresAt\":\"Expires {date}\",\"profileSettings.userDataExport.expiresIn\":\"Expires in {days, plural, one {# day} other {# days}}\",\"profileSettings.userDataExport.failed\":\"Previous export failed. Please try again.\",\"profileSettings.userDataExport.error\":\"Unable to load export status.\",\"profileSettings.emailPreferences.heading\":\"Email Preferences\",\"profileSettings.emailPreferences.categories\":\"Email Categories\",\"profileSettings.emailPreferences.description\":\"Choose which account emails you receive.\",\"profileSettings.emailPreferences.descriptionWithEmail\":\"Choose which account emails you receive at {email}.\",\"profileSettings.emailPreferences.noEmail\":\"No email address is connected to this account.\",\"profileSettings.emailPreferences.empty\":\"No email categories are available yet.\",\"profileSettings.emailPreferences.groupsError\":\"Email categories are temporarily unavailable. Please check back later.\",\"profileSettings.emailPreferences.error\":\"Unable to load your email preferences. Please check back later.\",\"userExportConfirm.modal.title\":\"Confirm Data Export\",\"userExportConfirm.modal.description\":'We will notify you via email when your downloadable link is ready. Please note that the link will expire after 7 days. To continue, please click \"Begin Export\".',\"userExportConfirm.modal.confirmButton\":\"Begin Export\",\"profileSettings.profileImageModal.pickProfileImage\":\"Pick your profile image\",\"profileSettings.profileImageModal.pickProfileImageDescription\":\"You can only choose square images with a 1:1 aspect ratio that also have either a Personalization code, a moodboard or a sref code.\",\"profileSettings.profileImageModal.pickBannerImage\":\"Pick your banner image\",\"profileSettings.profileImageModal.pickBannerImageDescription\":\"You can only choose landscape images with a 11:3 aspect ratio and either a Personalization code, a moodboard or a sref code.\",\"profileSettings.profileImageModal.generateNewImage\":\"Generate New Image\",\"profileSettings.profileImageModal.chooseImage\":\"Choose Image\",\"profileSettings.profileImageModal.chooseVideo\":\"Choose Video\",\"profileSettings.profileImageModal.checkingImage\":\"Checking image\",\"profileSettings.profileImageModal.cannotUseImage\":\"Cannot use this image\",\"profileSettings.profileImageModal.noSpotlightsYet\":\"No spotlights yet\",\"profileSettings.profileImageModal.unlockPersonalization\":\"Unlock Personalization to get a better image\",\"profileSettings.profileImageModal.pickImageEmptyState.title\":\"Nothing found\",\"profileSettings.profileImageModal.pickImageEmptyState.description\":\"Generate images using Personalizations, moodboards, or sref codes. You can also right-click any image or video in your feeds to pick it directly. Choosing any image or video for your profile will make it public if it was private.\",\"profileSettings.profileImageModal.welcomeSection.title\":\"Customize your profile!\",\"profileSettings.profileImageModal.welcomeSection.description\":\"Pick a banner and profile image, add your bio, and follow your favorite creators.\",\"profileSettings.profileImageModal.welcomeSection.profile.title\":\"Create your own space\",\"profileSettings.profileImageModal.welcomeSection.profile.description\":\"Choose your own unique username and display name, pick a banner and profile image, choose a bio to tell people about yourself, or link your social media accounts.\",\"profileSettings.profileImageModal.welcomeSection.spotlight.title\":\"Spotlight your best work!\",\"profileSettings.profileImageModal.welcomeSection.spotlight.description\":\"Spotlight your favorite images and videos to showcase them on your custom Profile page.\",\"profileSettings.profileImageModal.welcomeSection.follow.title\":\"Follow your favorite creators\",\"profileSettings.profileImageModal.welcomeSection.follow.description\":\"Follow your friends or cool people you find on the Explore page to see their latest work.\",\"profileSettings.autoMerge.prompt\":\"This login ({email}) is associated with another account you created. Would you like to merge the two?\",\"profileSettings.autoMerge.confirm\":\"Merge\",\"app.retry\":\"Retry\",\"checkout.linkExpired\":\"Link Expired\",\"checkout.linkExpiredDescription\":\"Please use {subscribeCommand} on the Bot again, or use the {accountPageLink}.\",\"checkout.subscribeCommand\":\"/subscribe\",\"checkout.accountPage\":\"Account Page\",\"profileSettings.errors.tryAgain\":\"Something went wrong. Please try again.\",\"auth.error.networkRequestFailed\":\"Unable to connect. Please check your internet connection and try again.\",\"auth.error.tooManyRequests\":\"Too many login attempts. Please wait a moment and try again.\",\"auth.error.popupBlocked\":\"Your browser blocked the login popup. Please allow popups for this site and try again.\",\"auth.existingAccountFound.title\":\"Sign-in options\",\"auth.existingAccountFound.accountExists\":\"Another account already exists for <strong>{email}</strong>.\",\"auth.existingAccountFound.signIn.withProvider\":\"Please log in with that account and then link it to your {provider} login:\",\"auth.existingAccountFound.signIn.withoutProvider\":\"Please log in with that account and then link it to your Midjourney account:\",\"auth.continueWithProvider\":\"Continue with {provider}\",\"auth.lastUsed\":\"Last used\",\"auth.signIn\":\"Log in\",\"auth.signUp\":\"Sign up\",\"termsOfService.modal.title\":\"It's time to start creating\",\"termsOfService.modal.text\":\"To use Midjourney, you need to accept our <a>Terms of Service</a>.\",\"termsOfService.link\":\"https://docs.midjourney.com/hc/en-us/articles/32083055291277-Terms-of-Service\",\"termsOfService.modal.button\":\"I accept the Terms of Service\",\"termsOfService.acceptButton\":\"Accept\",\"termsOfService.acceptButton.long\":\"Accept Terms of Service\",\"termsOfService.accepted\":\"Accepted\",\"captchaRequired.modal.title\":\"Pardon the interruption.\",\"captchaRequired.modal.description.idle\":`You've been making a lot of images. To keep going, we need to make sure you're not a robot.\n\nTo keep creating, please complete the captcha to continue.`,\"captchaRequired.modal.description.success\":\"Thanks for verifying your humanity!\",\"captchaRequired.modal.description.error\":\"Please try again later.\",\"teach.reportImages\":\"Report images\",\"teach.reportVideos\":\"Report videos\",\"teach.reportText\":\"Report text\",\"teach.submitReport\":\"Submit Report\",\"personalize.meta.description\":\"Personalize Midjourney to your tastes.\",\"personalize.moodboards\":\"Moodboards\",\"personalize.moodboards.description\":\"Collect uploaded or generated images to show your target style.\",\"personalize.newProfile\":\"New Profile\",\"personalize.imageAlt\":\"Image of a person with the Personalization code: {code}. Click to copy.\",\"personalize.promptLabel\":\"Prompt: A Person --p {code}\",\"personalize.overlayText\":\"'A Person' with different Personalizations\",\"personalize.emptyMoodboard\":\"Empty Moodboard\",\"personalize.emptyMoodboardDescription\":\"Add an image to get started\",\"personalize.emptyProfileDescription\":\"Continue ranking to unlock:\",\"personalize.emptyProfileDescriptionNijiV7\":\"Coming Soon! Rank images to get Fast hours\",\"personalize.unusedProfile\":\"No Creations Found\",\"personalize.heading\":\"Teach Midjourney about what you find beautiful.\",\"personalize.createProfile\":\"Create Profile\",\"personalize.createRankedProfile\":\"Create Ranked Profile\",\"personalize.versionWarning\":\"Profiles from other versions may not work as expected.\",\"personalize.creating\":\"Creating...\",\"personalize.globalProfile\":\"Global Profile\",\"personalize.noProfilesSelected\":\"No profiles selected\",\"personalize.noProfilesFound\":\"No profiles found\",\"personalize.globalProfileDesc\":\"Create your base Personalization profile.\",\"personalize.rankedProfileDesc\":\"Select from pairs of {service} images to teach the model about your preferences.\",\"personalize.rankedProfileDesc.midjourney\":\"Select from pairs of Midjourney images to teach the model about your preferences.\",\"personalize.rankedProfileDesc.nijiJourney\":\"Select from pairs of niji・journey images to teach the model about your preferences.\",\"personalize.moodboard\":\"Moodboard\",\"personalize.moodboardsPage.p1\":\"When words aren't enough, Moodboards let you collect images to show Midjourney the aesthetic you want.\",\"personalize.moodboardsPage.p2\":\"Focused moodboards give you consistency; diverse ones let you explore the frontier of creative possibilities.\",\"personalize.noMoodboardsSelected\":\"No moodboards selected yet\",\"personalize.noMoodboardsFound\":\"No moodboards found\",\"personalize.moodboard.dropImages\":\"Drop images over this page or \",\"personalize.moodboard.clickToSelect\":\"click here to select from your creations\",\"personalize.moodboard.addImages\":\"Add images with the buttons above to get started\",\"personalize.moodboard.beginPersonalize\":\"Once you have at least one image, you can start personalizing.\",\"personalize.moodboard.uploadImages\":\"Upload Images\",\"personalize.moodboard.uploadImages.description\":\"Upload images from your computer to add to your moodboard.\",\"personalize.moodboard.uploadImages.short\":\"Upload from your device.\",\"personalize.moodboard.addFromLink\":\"Add from Link\",\"personalize.moodboard.addFromLink.description\":\"Add images from around the web to your moodboard.\",\"personalize.moodboard.addFromLink.short\":\"Add from the web.\",\"personalize.moodboard.addFromGallery\":\"Add from Creations\",\"personalize.moodboard.addFromGallery.description\":\"Select images from your creations to add to your moodboard.\",\"personalize.moodboard.addFromGallery.short\":\"Select from your creations.\",\"personalize.moodboard.enterUrlPrompt\":\"Enter the URL of the image you want to add to your moodboard.\",\"common.scrollToBottom\":\"Jump to the Bottom\",\"teach.selectVideosToReport\":\"Select the videos you want to report.\",\"teach.selectImagesToReport\":\"Select the images you want to report.\",\"teach.selectTextToReport\":\"Select the text you want to report.\",\"app.undo\":\"Undo\",\"app.skip\":\"Skip\",\"app.image\":\"Image\",\"app.video\":\"Video\",\"app.questionMark\":\"?\",\"teach.startRanking\":\"Start ranking\",\"teach.imageCoherenceInstructions\":\"Image coherence instructions\",\"teach.meta.title\":\"Rate Images\",\"teach.meta.description\":\"Rate Midjourney Images\",\"teach.profileUnlocked.title\":\"Profile Unlocked\",\"teach.profileUnlocked.tryItOut\":\"Try it out\",\"teach.profileUnlocked.continueTeaching\":\"Continue teaching\",\"teach.profileUnlocked.modalTitle\":\"Personalization Profile Unlocked\",\"teach.profileUnlocked.subtitle\":\"It's available now in the Profiles section of the sidebar.\",\"teach.profileUnlocked.button\":\"Start Creating\",\"teach.profileUnlocked.notNow\":\"Not now\",\"teach.profileUnlocked.backButton\":\"Continue Personalizing\",\"teach.profileUnlocked.heading\":\"You've unlocked this Personalization profile!\",\"teach.profileUnlocked.codeLabel\":\"You can now create images using the Personalization code --p {code}.\",\"teach.progress.ofToUnlock\":\"of {min} to unlock Personalization profile\",\"teach.progress.nijiV7ComingSoon\":\"ratings. Niji V7 profiles are coming soon! You can use V6 profiles in the meantime.\",\"personalize.pointsLabel\":\"{count, plural, one {Point} other {Points}}\",\"teach.rankings\":\"{count, plural, one {point} other {points}}\",\"teach.batches\":\"batches\",\"teach.pairs\":\"{count, plural, one {point} other {points}}\",\"teach.selections\":\"selections\",\"teach.rankingsThisSession\":\"{count, plural, one {# point} other {# points}} this session\",\"teach.instructions.useNumberKeys\":\"Press <bold>1</bold> or <bold>2</bold> for quick selection, <bold>3</bold> to skip.\",\"teach.realVideoRanking\":\"Real Video Ranking\",\"teach.videoRanking\":\"Video Ranking\",\"teach.stylesRanking\":\"Styles Ranking\",\"teach.legacyImageRanking\":\"Legacy Image Ranking\",\"teach.nijiRanking\":\"Niji Image Ranking\",\"teach.v8Ranking\":\"V8 Ranking\",\"teach.textRanking\":\"Text Ranking\",\"teach.selectTextBeautiful\":\"Select the text you like most.\",\"teach.selectVideoBeautiful\":\"Select the video you find more beautiful.\",\"teach.selectVideoLikeBetter\":\"Select the video you like better, or press skip if uncertain.\",\"teach.selectStylesLikeBetter\":\"Select the style you like better, or press skip if uncertain.\",\"video.planDoesNotSupportRelaxMode\":\"Your plan doesn't support Relax mode for videos. Fast mode will be used.\",\"teach.selectImageBeautiful\":\"Select the image you find more beautiful.\",\"teach.selectImageBetter\":\"Select the image you like better, or press skip if uncertain.\",\"teach.selectImageCommunity\":\"Select the image that you think most belongs on the Explore page.\",\"teach.skipHint\":\"Skip if you're uncertain. Hold the {ctrl} or {cmd} key and click an image to open it in a new tab with the prompt.\",\"teach.accuracy.title\":\"Select the image that best matches the prompt.\",\"teach.accuracy.subtitle\":\"Decide only based on prompt accuracy. Skip if you're uncertain or images are equally good.\",\"teach.coherence.title\":\"Select the image that has the best image coherence.\",\"teach.coherence.subtitle\":\"Decide only based on prompt accuracy, and not if you like the image. Skip if you're uncertain or images are equally good.\",\"rank.accuracy.mobileRestriction\":\"You can only rank prompt accuracy on larger screens.\",\"rank.videoUnsupported\":\"Video ranking is currently not supported on mobile devices.\",\"rank.stylesUnsupported\":\"Styles ranking is currently not supported on mobile devices.\",\"rank.accuracy.goToAestheticRanking\":\"Go to aesthetic ranking\",\"rank.accuracy.instructions\":\"Choose the image that most {accuratelyMatches} the prompt.\",\"rank.accuracy.accuratelyMatches\":\"accurately matches\",\"rank.accuracy.skipIfEqual\":\"Skip the pair if the images are equally accurate to the prompt.\",\"rank.accuracy.rankingsDisclaimer\":\"Rankings {doNot} affect your Personalization.\",\"rank.accuracy.doNot\":\"do not\",\"rank.coherence.chooseMostCorrect\":\"Choose the image that looks the most correct.\",\"rank.coherence.lookAtAnatomy\":\"Look at anatomy, handheld objects, far away faces, and other complex objects before making a decision.\",\"rank.coherence.skipIfUncertain\":\"Skip if you are uncertain. Do not rank based on how much you like the image.\",\"rank.youHaveRankedMessage\":\"You have ranked {numRankings} {numRankings, plural, one {point} other {points}}. Rank {minRankings} {minRankings, plural, one {point} other {points}} to {continueText}.\",\"rank.nextPersonalizationMessage\":\"Next Personalization is unlocked, press {submitButton} at the bottom to claim your Fast hours.\",\"rank.failedToLoadImageMessage\":\"Failed to load image,{br}click here to skip and continue\",