potlightSomething\":\"Spotlight something\",\"userFeed.emptyState.subscribeToGetStarted\":\"Subscribe to get started\",\"userFeed.spotlightEmptyState.title.viewingProfile\":\"{displayName} has not spotlighted anything yet!\",\"userFeed.spotlightEmptyState.description.viewingProfile\":\"Check in later to see if {displayName} has spotlighted anything!\",\"userFeed.archiveEmptyState.title\":\"No creations yet!\",\"userFeed.archiveEmptyState.description\":\"Private and trashed creations do not show here. Head over to the Create page to create something.\",\"userFeed.archiveEmptyState.createSomething\":\"Create something\",\"userFeed.archiveEmptyState.seeSomeoneElse\":\"See someone else\",\"userFeed.archiveEmptyState.title.viewingProfile\":\"{displayName} has not created anything yet!\",\"userFeed.archiveEmptyState.description.viewingProfile\":\"Check in later to see if {displayName} has created anything!\",\"userFeed.followingEmptyState.title\":\"You're not following anyone yet!\",\"userFeed.followingEmptyState.description\":\"Following members helps you keep up with their creations. Click the + button on the Explore page or on their Profile page to follow someone.\",\"userFeed.followingEmptyState.followPeople\":\"Follow Members\",\"userFeed.profileNotFound.title\":\"Profile not found\",\"userFeed.profileNotFound.description\":\"The profile you are looking for does not exist. Try exploring other profiles.\",\"userFeed.profileNotFound.goToExplore\":\"Go to Explore\",\"userFeed.profileNotFound.seeANewProfile\":\"See a new profile\",\"userFeed.reportUser\":\"Report member\",\"userFeed.reportUserModal.title\":\"Report Profile\",\"userFeed.reportUserModal.description\":\"Report inappropriate content in this profile.\",\"userFeed.reportUserModal.actionButton\":\"Report Profile\",\"userFeed.reportUserModal.reasonPlaceholder\":\"Provide additional details about why you're reporting this...\",\"userFeed.reportUserModal.reasonLength\":\"{length}/{maxLength}\",\"userFeed.reportUserModal.fieldLabel\":\"What are you reporting?\",\"userFeed.reportUserModal.reasonLabel\":\"Reason (optional)\",\"userFeed.reportUserModal.successMessage\":\"Thank you for your report. We'll review it shortly.\",\"common.youveReachedTheEnd\":\"You've reached the end\",\"gallery.loadingMore\":\"Loading more...\",\"gallery.lookingForMore\":\"Looking for more...\",\"gallery.thatsAllWeHave\":\"That's all we have\",\"gallery.thatsEveryoneYouFollow\":\"That's everyone you follow\",\"gallery.logInToSeeMore\":\"Log in to see more\",\"gallery.learnMore\":\"Want to learn more? <link>Read our guide to get started.</link>\",\"gallery.unauthedDemoClickToExpand\":\"Click to expand\",\"gallery.likesEmptyState.title\":\"You haven't liked any images yet!\",\"gallery.likesEmptyState.description\":\"Liking images is private so only you can see them. Click the heart icon on the Explore page to like an image.\",\"gallery.likesEmptyState.exploreImages\":\"Explore Images\",\"gallery.videoLikesEmptyState.title\":\"You haven't liked any videos yet!\",\"gallery.videoLikesEmptyState.description\":\"Liking videos is private so only you can see them. Click the heart icon on the Explore page to like a video.\",\"gallery.videoLikesEmptyState.exploreVideos\":\"Explore Videos\",\"gallery.stylesLikesEmptyState.title\":\"You haven't liked any styles yet!\",\"gallery.stylesLikesEmptyState.description\":\"Liking styles is private so only you can see them. Click the heart icon on the Explore page to like a style.\",\"gallery.stylesLikesEmptyState.exploreStyles\":\"Explore Styles\",\"gallery.nothingToSeeRightNow\":\"Nothing to see right now\",\"gallery.noImagesSomeHiddenFiltered\":\"No images. Some may be hidden or filtered.\",\"gallery.endWithHiddenItems\":\"You've reached the end · {hiddenCount, plural, one {# item} other {# items}} hidden\",\"gallery.dragImagesToFolderOrMakeNew\":\"Drag images to this folder, or make new ones\",\"gallery.noResultsFor\":'No results for \"{query}\"',\"gallery.yourCreationsWillAppearHere\":\"Your creations will appear here\",\"modal.v8.titleFull\":\"Midjourney {subtitle} is here\",\"modal.v8.subtitle\":\"V8.1\",\"modal.v8.welcome\":\"V8.1 is Midjourney's newest image model. It follows detailed prompts with much more precision, generates up to ~5x faster than V7, and renders natively at 2K in HD.\",\"modal.v8.personalizationRequired\":\"V8.1 uses personalization by default — setting yours up only takes a few minutes.\",\"modal.v8.promptUnderstanding.title\":\"Smarter Understanding\",\"modal.v8.promptUnderstanding.description\":\"V8.1 follows detailed prompts with precision, renders quoted text reliably, and --raw gives you extra control when you want it.\",\"modal.v8.speed.title\":\"Faster Generation\",\"modal.v8.speed.description\":\"V8.1 generates images up to ~5x faster than V7, so you can iterate on ideas without waiting.\",\"modal.v8.hdSupport.title\":\"Higher Resolution\",\"modal.v8.hdSupport.description\":\"A new --hd mode natively renders images at 2K resolution — sharper detail for close-ups, prints, and large displays.\",\"modal.v8.personalization.title\":\"Deeper Personalization\",\"modal.v8.personalization.description\":\"Your V7 personalization profiles, moodboards, and srefs all work in V8.1, with more accuracy than ever.\",\"modal.v8.startUsing\":\"Start Using V8.1\",\"modal.v8.unlockCta\":\"Unlock Personalization for V8.1\",\"modal.v8.unlockComplete.title\":\"Personalization Unlocked\",\"modal.v8.unlockComplete.subtitle\":\"You're ready to start using V8.1 now.\",\"modal.v8.unlockComplete.button\":\"Start Using V8.1\",\"modal.v8.unlockComplete.backButton\":\"Continue Personalizing\",\"modal.v8.remindLater\":\"Remind me later\",\"modal.v8.readMore\":\"Read more about V8.1 on our {blogLink}.\",\"modal.v8.readMore.linkText\":\"blog\",\"modal.v8Personalize.unlockTitle\":\"Unlock your personalization to use V{version}\",\"modal.v8Personalize.continueTitle\":\"Continue unlocking your personalization to use V{version}\",\"modal.v8Personalize.unlockBody\":\"V{version} has model personalization turned on by default. You must unlock your personalization to use it. This takes ~5 minutes. You can toggle it on/off at any time from the prompt bar.\",\"modal.v8Personalize.unlockBodyExtra\":\"We think personalization raises the bar for how well we can interpret what you want and what you find beautiful.\",\"modal.v8Personalize.continueBody\":\"You've started unlocking personalization. Finish the remaining rankings to use V{version}. You can toggle it on/off at any time from the prompt bar.\",\"modal.v8Personalize.unlockButton\":\"Unlock Personalization\",\"modal.v8Personalize.continueButton\":\"Continue Personalizing\",\"modal.v8Personalize.continueV7\":\"Continue using V7\",\"banner.personalizeSetup.lead\":\"Generate images you’ll love.\",\"banner.personalizeSetup.link\":\"Set up your personalization in just three minutes →\",\"banner.personalizeNag.title\":\"Generate images you’ll love.\",\"banner.personalizeNag.body\":\"Train Midjourney on your taste in just three minutes.\",\"banner.personalizeNag.cta\":\"Get started\",\"banner.personalizeNag.remindLater\":\"Remind me later\",\"setDefaultResolution.title\":\"Set the default resolution for your images\",\"setDefaultResolution.sd.name\":\"Standard Definition\",\"setDefaultResolution.sd.dimensions\":\"1024x1024px\",\"setDefaultResolution.sd.time\":\"Takes 4 seconds\",\"setDefaultResolution.sd.cost\":\"Uses 0.8 Fast minutes\",\"setDefaultResolution.hd.name\":\"High Definition\",\"setDefaultResolution.hd.dimensions\":\"2048x2048px\",\"setDefaultResolution.hd.time\":\"Takes 12 seconds\",\"setDefaultResolution.hd.cost\":\"Uses 1.3 Fast minutes\",\"setDefaultResolution.staySd\":\"Stay on SD\",\"setDefaultResolution.switchHd\":\"Switch to HD\",\"modal.draft.conversationalMode\":\"Conversational Mode...\",\"modal.draft.examples.poodleCactus\":\"A cute poodle in a flowering cactus garden\",\"modal.draft.examples.poodleLandscape\":\"Perfect! Can you make it landscape, in a cacti garden?\",\"modal.draft.examples.poodleTropical\":\"A cute poodle in a tropical rainforest\",\"modal.draft.examples.poodleTropics\":\"Make the dog a poodle, and put it the tropics for me\",\"modal.draft.examples.dogSnow\":\"A cute dog in the snow\",\"modal.draft.examples.niceDog\":\"Show me a nice dog\",\"modal.draft.examples.inputPrompt\":\"Can you give it a hat?\",\"modal.draft.welcomeTitle\":\"Welcome to Conversational Mode\",\"modal.draft.description\":\"In combination with Draft mode, Conversational mode helps you move faster—images generate quickly, and rough ideas become visuals without slowing you down.\",\"modal.draft.perfectPrompt.title\":\"No need to write the perfect prompt\",\"modal.draft.perfectPrompt.description\":\"Say what you're after—Conversational mode reshapes and refines your input so you can focus on the idea, not the wording.\",\"modal.draft.workThink.title\":\"Work how you think\",\"modal.draft.workThink.description\":\"Speak or type your thoughts as they come. Conversational mode keeps up, so you can stay in the creative flow.\",\"modal.draft.enhance.title\":\"Refine Your Favorite Drafts\",\"modal.draft.enhance.description\":\"When you find a draft you love, use Vary Subtle to create a refined variation.\",\"modal.draft.begin\":\"Get Started\",\"modal.profile.personExample\":\"'A Person' with different Personalizations\",\"modal.profile.shouldTry\":\"You should try Personalizing Midjourney\",\"modal.profile.preferPersonalized\":\"Over 85% of members prefer personalized images versus the standard ones.\",\"modal.profile.processSimple\":\"The process is simple. We show you two images and you pick the one you find most beautiful.\",\"modal.profile.unlocksForYouFeed\":\"Completing your Personalization also unlocks the {forYouLabel} feed.\",\"modal.profile.forYouLabel\":\"For You\",\"modal.profile.getStarted\":\"Get started in under two minutes!\",\"modal.profile.personalizeFirst\":\"Create Your First Profile\",\"modal.profile.remindLater\":\"Remind me later\",\"modal.subscribe.exploreFrontiers\":\"Explore the Frontiers of Imagination\",\"modal.subscribe.advancedModels\":\"With the world's most advanced image and video models and regular updates with community-steered roadmaps.\",\"modal.subscribe.joinCommunity\":\"Join our creative community\",\"modal.subscribe.communityDescription\":\"Enjoy open access to billions of images and prompts with daily trends and real-time search\",\"modal.subscribe.multipleTiers\":\"Multiple plans for everyone\",\"modal.subscribe.memberships\":\"Plans start at $10/mo with a 20% discount on yearly plans\",\"modal.subscribe.joinNow\":\"Join now\",\"modal.subscribe.lookAround\":\"Look Around a Bit\",\"modal.subscribe.maybeLater\":\"Maybe Later\",\"modal.subscribe.alreadySubscribed\":\"I'm already subscribed\",\"modal.subscribe.returning.exploreFrontiers\":\"Your Imagination Has Been Waiting\",\"modal.subscribe.returning.advancedModels\":\"Subscribe again to get back to creating.\",\"modal.subscribe.returning.joinCommunity\":\"New Models and Features\",\"modal.subscribe.returning.communityDescription\":\"Get the best images with the latest Midjourney models and improvements to our site.\",\"modal.subscribe.returning.multipleTiers\":\"Plans Start at $10 per Month\",\"modal.subscribe.returning.memberships\":\"Choose monthly or yearly plans.\",\"modal.subscribe.returning.savedData\":\"Your Work Is Still Here\",\"modal.subscribe.returning.savedDataDescription\":\"You can always view your images and videos, even if you're not subscribed.\",\"modal.subscribe.returning.joinNow\":\"View Plans\",\"modal.subscribe.recentlyExpired.exploreFrontiers\":\"Your Journey Has Come to a Rest\",\"modal.subscribe.recentlyExpired.advancedModels\":\"Your subscription has ended, but you can subscribe again at any time.\",\"modal.subscribe.recentlyExpired.joinCommunity\":\"Your Data Is Still Here\",\"modal.subscribe.recentlyExpired.communityDescription\":\"You can always view your images and videos, even if you're not subscribed.\",\"modal.subscribe.recentlyExpired.multipleTiers\":\"Start Again at $10 per Month\",\"modal.subscribe.recentlyExpired.memberships\":\"Choose monthly plans for flexibility, or save with an annual plan.\",\"modal.subscribe.recentlyExpired.joinNow\":\"See Plans\",\"modal.accessGate.title\":\"You don't have access to {env}\",\"modal.accessGate.description.alpha\":\"{env} is available to subscribers who have created at least 10 images on midjourney.com. Subscribe and start creating to unlock access.\",\"modal.accessGate.description.internal\":\"{env} is restricted to authorized Midjourney team members.\",\"modal.accessGate.viewPlans\":\"View Plans\",\"modal.accessGate.goToMidjourney\":\"Go to midjourney.com\",\"modal.survey.exploreMind\":\"Explore Your Mind\",\"modal.survey.signupReports\":\"Sign up to get free personality reports\",\"modal.survey.knowYourself\":\"Get to know yourself\",\"modal.survey.personalityMeasures\":\"Discover how you score on 200+ personality measures and learn how your values and beliefs shape your interactions with the world.\",\"modal.survey.joinNow\":\"Join now\",\"modal.survey.alreadyAccount\":\"Already have an account?\",\"modal.survey.logIn\":\"Log in\",\"modal.officeHours.title\":\"Office Hours Is Live!\",\"modal.officeHours.message\":\"Join to hear updates from Midjourney and what the team is working on. You can also ask questions and leave feedback.\",\"modal.officeHours.joinOnDiscord\":\"Join on Discord\",\"modal.officeHours.joinOnX\":\"Join on X\",\"modal.medicalScannerWatchParty.title\":\"Unveiling our first secret hardware project\",\"modal.medicalScannerWatchParty.message\":\"Tune in now to watch the livestream of our first secret hardware project\",\"modal.tos.optionRequiredMessage\":\"This option is required to proceed.\",\"modal.tos.essentialCookies\":\"Midjourney requires essential cookies to function properly.\",\"modal.tos.essentialCookiesTitle\":\"Essential Cookies\",\"modal.tos.readCookiePolicy\":\"Read our Cookie Policy\",\"modal.tos.privacySettings\":\"Privacy Settings\",\"modal.tos.ccpaTitle\":\"Do Not Sell or Share My Personal Information\",\"modal.tos.loggedInAsUser\":\"You are logged in as {userEmail}.\",\"modal.tos.notLoggedIn\":\"You are not logged in. Your preferences will only apply to this browser. To have your preferences synced, please log in.\",\"modal.tos.dataHandlingInfo\":\"You can learn more about how we handle your data in our {cookiePolicyLink}. You can adjust your preferences below.\",\"modal.tos.cookiePolicy\":\"cookie policy\",\"modal.tos.analyticsCookies\":\"Analytics Cookies\",\"modal.tos.analyticsDescription\":\"Help us understand which features are most useful to improve Midjourney.\",\"modal.tos.analyticsDescriptionLong\":\"Helps us understand how our site and services are used so we can measure and improve performance and product features.\",\"modal.tos.advertisingCookies\":\"Advertising Cookies\",\"modal.tos.advertisingDescription\":\"Help us understand which ads and referrals are most effective.\",\"modal.tos.advertisingDescriptionLong\":\"May be used to show you relevant ads across websites and track the effectiveness of our advertising campaigns.\",\"modal.tos.reject\":\"Reject\",\"modal.tos.refreshChanges\":\"Refresh the page for changes to take effect.\",\"confirmBatchHDVideo.modal.title\":\"Confirm Batch HD Video Creation\",\"confirmBatchHDVideo.modal.createVideos\":\"I understand HD video will use up my Fast hours quickly.\",\"confirmBatchHDVideo.modal.description\":\"We want to make all our tools available on all plans, but HD videos are currently expensive to create.\",\"confirmBatchHDVideo.modal.confirmation\":\"Making a single HD video uses about <highlight>7 Fast minutes</highlight>, and a batch of 4 uses <highlight>26 Fast minutes</highlight>. Your plan has <highlight>15 Fast hours</highlight> per month, and if you run out, you'll have to buy more if you want to make more videos.\",\"currency.dollarSign\":\"$\",\"currency.monthlyPrivate\":\"20 / month\",\"currency.openParen\":\"(\",\"currency.closeParen\":\")\",\"currency.minus\":\"-\",\"modal.cancelTimeframe\":\"Cancel timeframe\",\"modal.confirmPurchase\":\"Confirm your purchase\",\"modal.timeRemainingInMonth\":\"Time remaining in month\",\"modal.currentBalance\":\"Current balance\",\"modal.finalBalance\":\"Final balance\",\"modal.unusedStealthMode\":\"Unused Stealth mode\",\"modal.outstandingMeteredUsage\":\"Outstanding metered usage\",\"purchase.forDollar\":\"for $\",\"purchase.withA\":\"with a\",\"hours.fastHour\":\"{count, plural, one {# Fast hour} other {# Fast hours}}\",\"hours.included\":\"{used} / {total}\",\"hours.multiplyBy\":\"{count}x\",\"pricing.pricePerMonth\":\"{price} / mo\",\"pricing.balanceAmount\":\"({amount})\",\"pricing.activeUntil\":\"ACTIVE UNTIL {date}\",\"pricing.limitedGenerationsTooltip\":\"One image job has four images, so {jobs} jobs is {images} images.\",\"help.howCanWeHelp\":\"How can we help?\",\"reportBug.title\":\"Report a Bug\",\"reportBug.sendReport\":\"Send Report\",\"reportBug.submitting\":\"Submitting...\",\"reportBug.submitted\":\"Submitted!\",\"reportBug.thankYou\":\"Thank you for your report.\",\"reportBug.backToForm\":\"Back to form\",\"reportBug.category\":\"Category\",\"reportBug.selectCategory\":\"Select a category\",\"reportBug.jobsOrPrompts\":\"Jobs or Prompts\",\"reportBug.attachImages\":\"Attach Images\",\"reportBug.note\":\"Note:\",\"reportBug.noteText\":\"Bug reports won't usually receive a response.\",\"reportBug.assistanceText\":\"If you need help, please\",\"reportBug.submitTicket\":\"submit a ticket\",\"reportBug.placeholder.details\":\"These messages will not receive a response. Email billing@midjourney.com for issues with accounts and subscriptions. If reporting a bug, describe it in detail. Include steps to reproduce if possible.\",\"reportBug.affectedJobUrlOrPrompt.placeholder\":\"Affected job URL or prompt\",\"reportBug.placeholder.describe\":\"Describe your bug report in detail. Include steps to reproduce if possible.\",\"reportBug.category.website\":\"Website\",\"reportBug.category.imageQuality\":\"Image quality\",\"reportBug.category.moderation\":\"Moderation\",\"reportBug.category.generalError\":\"General error\",\"reportBug.category.other\":\"Other\",\"reportBug.addScreenshot\":\"Add Screenshot\",\"reportBug.period\":\".\",\"reportBug.metrics.v8Model\":\"V8 Model\",\"reportBug.metrics.v7Model\":\"V7 Model\",\"reportBug.metrics.v6Model\":\"V6 Model\",\"reportBug.metrics.v6Upscaler\":\"V6 Upscaler\",\"reportBug.metrics.nijiV7\":\"Niji V7\",\"reportBug.metrics.nijiV6\":\"Niji V6\",\"reportBug.metrics.nijiV6Upscaler\":\"Niji V6 Upscaler\",\"reportBug.metrics.video\":\"Video\",\"systemStatus.title\":\"System Status\",\"systemStatus.waitTimes\":\"Wait times\",\"systemStatus.model\":\"Version\",\"systemStatus.fast\":\"Fast\",\"systemStatus.relax\":\"Relax\",\"systemStatus.ok\":\"Ok\",\"systemStatus.notOk\":\"Not Ok\",\"systemStatus.imageGeneration\":\"Image Generation\",\"systemStatus.discordBot\":\"Discord Bot\",\"systemStatus.gallery\":\"Website\",\"inputButtons.conversationalMode\":\"Conversational Mode\",\"inputButtons.noMoodboards\":\"No Moodboards Found\",\"inputButtons.noProfiles\":\"No Profiles Found\",\"inputButtons.conversationalModeDescription\":\"Refine your prompt using text or voice.\",\"inputButtons.personalizeDisabledDescription\":\"An unlocked Global Profile or a selected Moodboard is required to use Personalization.\",\"inputButtons.personalizationNotAvailableOnModel\":\"Personalization is not available on this version. Click to select a different version.\",\"inputButtons.draftMode\":\"Draft Mode\",\"inputButtons.draftModeDescription\":\"Create much faster with draft quality images.\",\"inputButtons.draftModeDescriptionV81\":\"Explore at draft quality and refine with variations.\",\"inputButtons.requiredInVoiceMode\":\"Required in Voice Mode\",\"voice.selectInputDevice\":\"Select Input Device\",\"voice.microphoneMuted\":\"Microphone muted\",\"voice.mutedForInactivity\":\"Sounds like you're not speaking to us so we've muted your microphone.\",\"inputButtons.folders\":\"Folders\",\"inputButtons.closeFolder\":\"Close Folder\",\"inputButtons.personalizeShort\":\"P\",\"inputButtons.selectPersonalizations\":\"Select Personalizations\",\"inputButtons.selectModelToEnablePersonalization\":\"Switch to a model below to enable Personalization\",\"inputButtons.rateMoreImages\":\"Rate More Images\",\"inputButtons.teachMidjourneyAboutBeauty\":\"Teach Midjourney about what you find beautiful.\",\"inputButtons.personalizeDescription\":\"Profiles help Midjourney learn what you like and shape images to your taste.\",\"inputButtons.unlockPersonalization\":\"Unlock Personalization\",\"inputButtons.createMoodboard\":\"Create a Moodboard\",\"inputButtons.createMoodboardDescription\":\"Add images to Moodboards to give Midjourney visual inspiration.\",\"inputButtons.v6\":\"V6\",\"inputButtons.nijiV7ComingSoon\":\"Niji V7 profiles are coming soon! In the meantime, you can already rate Niji V7 images which will be taken into account for your Personalization profile.\",\"inputButtons.rateImages\":\"Rate Images\",\"personalize.nijiV7ComingSoon\":\"Niji V7 profiles are coming soon!\",\"personalize.nijiV7NotReady\":\"Niji V7 Personalization is not available yet. Check back soon!\",\"personalize.unspokenDetails\":'Inside every prompt are \"unspoken\" details. Midjourney tries to fill them in to make the image as compelling as possible for the entire community.',\"personalize.uniqueTastes\":\"But your tastes are unique! Do you like cute animals or fearless fantasy creatures? Buildings old and rugged, or sleek and modern? Making a Personalization profile helps Midjourney get to know you and shape images toward what you love.\",\"personalize.createProfiles\":\"Create Personalization profiles to teach Midjourney what you like.\",\"personalize.all\":\"All\",\"personalize.selected\":\"Selected\",\"personalize.select\":\"Select\",\"personalize.addImages\":\"Add Images\",\"personalize.addRankings\":\"Add Rankings\",\"personalize.leftParen\":\"(\",\"personalize.rightParen\":\")\",\"personalize.unselectAll\":\"Unselect All\",\"personalize.profiles\":\"Profiles\",\"personalize.supportedModels\":\"Supported Models\",\"personalize.moodboards.p1\":\"Define Your Vision.\",\"personalize.moodboards.p2\":\"Visually.\",\"personalize.newMoodboard\":\"New Moodboard\",\"personalize.unlockMessage\":\"Create a Global Profile to unlock Personalization.\",\"personalize.unlockCreateProfile\":\"Finish setting up your Global Profile to create additional profiles.\",\"personalize.moodboards.notFound.title\":\"Moodboard Not Found\",\"personalize.moodboards.notFound.description\":\"This moodboard may have been deleted or you don't have permission to view it.\",\"personalize.moodboards.notFound.goToMoodboards\":\"See your Moodboards\",\"personalize.useSetting\":\"Use Setting\",\"personalize.untitled\":\"Untitled\",\"personalize.untitledProfile\":\"Untitled Profile\",\"personalize.untitledMoodboard\":\"Untitled Moodboard\",\"personalize.defaultMoodboardName\":\"moodboard #{number}\",\"personalize.defaultPersonalizationProfileName\":\"Personalization profile #{number}\",\"personalize.moodboardImageCountTooltip\":\"Number of images in this moodboard\",\"personalize.personalizationProfileRankingCountTooltip\":\"Number of rankings in this Personalization profile\",\"personalize.moodboardUsageCountTooltip\":\"Number of times this moodboard has been used in a job\",\"personalize.personalizationProfileUsageCountTooltip\":\"Number of times this Personalization profile has been used in a job\",\"personalize.deletePersonalizationProfile.title\":\"Delete Personalization Profile?\",\"personalize.deletePersonalizationProfile.body\":\"This Personalization profile has {count, plural, one {# ranking} other {# rankings}}. Do you want to delete it?\",\"personalize.deleteMoodboard.title\":\"Delete Moodboard?\",\"personalize.deleteMoodboard.body\":\"This moodboard has {count, plural, one {# image} other {# images}}. Do you want to delete it?\",\"personalize.setAsDefault\":\"Set as Default\",\"personalize.inPrompt\":\"in Prompt\",\"personalize.personalizationLocked\":\"Personalization Locked\",\"personalize.personalizationOn\":\"Personalization On\",\"personalize.personalizationOff\":\"Personalization Off\",\"personalize.enabledSummary\":\"{profileCount, plural, =0 {} one {# Profile} other {# Profiles}}{comma}{moodboardCount, plural, =0 {} one {# Moodboard} other {# Moodboards}} selected\",\"personalize.enabledSummaryNoPersonalizations\":\"Defaulting to Global Profile\",\"personalize.modelVersionDoesNotSupportPersonalization\":\"Personalization is not available on this version. Toggling will swap to a newer version.\",\"personalize.youHaveUnlockedPersonalization\":\"You have unlocked Personalization.\",\"personalize.unsupportedVersionTitle\":\"Unsupported Version\",\"personalize.unsupportedVersionMessage\":\"This version does not support Personalization.\",\"personalize.pleaseSelectFollowingModels\":\"Please select one of the following models:\",\"moodboard.swapToVersion\":\"Swap to {prefix}{version}\",\"moodboard.viewCreations\":\"View Creations\",\"moodboard.viewMoodboard\":\"View Moodboard\",\"moodboard.globalProfileTooltip\":\"This is a Global Profile.\",\"moodboard.useMoodboardInPrompt\":\"Use Moodboard in Prompt\",\"moodboard.useProfileInPrompt\":\"Use Profile in Prompt\",\"moodboard.globalProfilesVersionRestriction\":\"Global Profiles can only be used with their own versions.\",\"moodboard.profilesVersionRestriction\":\"This profile doesn't support the current model version.\",\"moodboard.selection.added\":\"{count, plural, one {# added} other {# added}}\",\"moodboard.selection.removed\":\"{count, plural, one {# removed} other {# removed}}\",\"moodboard.selection.addedAndRemoved\":\"{added, plural, one {# added} other {# added}}, {removed, plural, one {# removed} other {# removed}}\",\"profileSettings.pleaseSignInAgain\":\"Please sign in again to access your profile\",\"profileSettings.refreshForChanges\":\"Refresh the page for changes to take effect.\",\"profileSettings.analyticsCookies\":\"Analytics Cookies\",\"profileSettings.analyticsCookiesDescription\":\"Help us understand which features are most useful to improve Midjourney.\",\"profileSettings.advertisingCookies\":\"Advertising Cookies\",\"profileSettings.advertisingCookiesDescription\":\"Help us understand which ads and referrals are most effective.\",\"profileSettings.copied\":\"Copied!\",\"common.bodyOverflowHidden\":\"body { overflow-y: hidden; }\",\"common.sorry\":\"Sorry!\",\"error.404\":\"404\",\"error.pageNotImagined\":\"This page has not been /imagine'd yet.\",\"error.pageTemporarilyGone\":\"This page is temporarily gone. For support, please visit <help>Help</help>\",\"rooms.noLongerAvailable\":\"Rooms is no longer available.\",\"rooms.buildingSomethingBetter\":\"We're building something better. <link>Learn more here</link>\",\"error.userDoesNotExist\":\"This member does not exist\",\"editor.editorUnsupported\":\"The Editor is currently unsupported\",\"editor.onMobileDevices\":\"on mobile devices.\",\"editor.uploadingSessions\":\"Uploading sessions: {current} / {total}\",\"editor.uploadingMessage\":\"We are uploading your Editor sessions so that you can access them from anywhere. This will take a few seconds and only needs to happen once.\",\"maintenance.plannedMaintenance\":\"We are currently undergoing planned maintenance.\",\"maintenance.backUpShortly\":\"Midjourney services will be back up shortly.\",\"common.viewUser\":\"View Member\",\"common.recentlyViewed\":\"Recently Viewed\",\"common.openInModTools\":\"Open In Mod Tools\",\"common.clickForMore\":\"Click for more\",\"common.idWithEllipsis\":\"{id}…\",\"sharedSignin.verifyingAuth\":\"Verifying authentication...\",\"sharedSignin.continueWith\":\"Continue with shared login\",\"tea