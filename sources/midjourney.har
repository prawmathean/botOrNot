tio (default 1:1)\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--v\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--v 7\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Model version\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--stylize\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--stylize 500\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Stylization strength (0–1000)\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--chaos\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--chaos 50\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Variation between results (0–100)\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--no\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--no text, logos\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Negative prompt — things to avoid\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--seed\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--seed 42\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Reproducible results\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--raw\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--raw\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Less opinionated, more literal interpretation\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--sref\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--sref <url>\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Style reference from an image URL\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--quality\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--quality 2\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Rendering quality / GPU time\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--p\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--p\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Apply your personalization profile\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--weird\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--weird 500\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Add unconventional aesthetics (0–3000)\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--tile\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--tile\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Generate seamlessly tileable patterns\"})]}),q(\"tr\",{className:\"align-top\",children:[Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--hd\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5 font-mono text-[13px]\",children:\"--hd\"}),Y(\"td\",{className:\"border-b border-[#2a2a30] px-3 py-2.5\",children:\"Generate at higher resolution\"})]})]})]}),q(M5,{children:[\"Full parameter reference: \",Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://docs.midjourney.com\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"docs.midjourney.com\"})]})]})},{title:\"Authentication\",body:q(a,{children:[Y(M5,{children:\"The MCP server uses OAuth 2.1 with PKCE for secure authentication. Your AI client handles the flow automatically — you just log in when prompted.\"}),Y(FQ,{children:`Your AI Client                    Midjourney MCP Server              midjourney.com\n     │                                    │                              │\n     │  1. Call generate_image            │                              │\n     │ ─────────────────────────────────▶ │                              │\n     │                                    │                              │\n     │  2. 401 — login required           │                              │\n     │ ◀───────────────────────────────── │                              │\n     │                                    │                              │\n     │  3. Opens browser                  │                              │\n     │ ────────────────────────────────────────────────────────────────▶ │\n     │                                    │                              │\n     │  4. You log in + approve           │                              │\n     │ ◀──────────────────────────────────────────────────────────────── │\n     │                                    │                              │\n     │  5. Token exchange (automatic)     │                              │\n     │ ◀─────────────────────────────────▶│                              │\n     │                                    │                              │\n     │  6. generate_image succeeds        │                              │\n     │ ◀───────────────────────────────── │                              │`}),Y(M5,{children:\"Tokens refresh automatically. If your session expires, the client re-initiates the flow.\"})]})},{title:\"Tips\",body:q(\"ul\",{className:\"mb-4 list-disc space-y-2.5 pl-6\",children:[q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"Let the AI handle prompt engineering. \"}),\"Describe what you want in plain English — the assistant translates that into optimized Midjourney prompts.\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"Use --seed for reproducibility. \"}),\"Lock the seed when you need consistent results across generations (e.g. same character).\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"Use --sref for style consistency. \"}),\"Pass a CDN URL from a previous generation as a style reference to maintain a cohesive look.\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"High --chaos for exploration, low for refinement. \"}),\"Start with --chaos 50–80 to explore ideas, then drop to 0 when you know what you want.\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"Variations are cheaper than re-generating. \"}),\"If you like 80% of an image, use generate_variation instead of re-prompting from scratch.\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"CDN URLs work everywhere. \"}),\"The cdn_url in the response is a public HTTPS link — embed it directly in your app, slides, or demo.\"]}),q(\"li\",{children:[Y(\"strong\",{className:\"text-white\",children:\"Match aspect ratio to destination. \"}),\"16:9 for hero images, 1:1 for icons/avatars, 9:16 for mobile.\"]})]})},{title:\"Examples\",body:q(a,{children:[Y(\"h3\",{className:\"mb-2 mt-1 text-[17px] text-white\",children:\"Basic generation\"}),Y(M5,{children:\"Just ask your AI assistant to make an image. It calls Midjourney automatically.\"}),Y(FQ,{children:`You:  Generate a watercolor painting of a mountain lake at sunrise\n\nClaude: I'll generate that for you.\n        → calls generate_image(\"watercolor painting of a mountain lake at sunrise\")\n        → returns preview image + CDN link`}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"With parameters\"}),Y(FQ,{children:`You:  Create a cinematic wide shot of a neon-lit Tokyo alley, 16:9, high stylization\n\nClaude: → generate_image(\"cinematic wide shot of a neon-lit Tokyo alley --ar 16:9 --stylize 750\")`}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Iterative workflow\"}),Y(M5,{children:\"Generate, look, refine — let the assistant manage prompts and variations for you.\"}),Y(FQ,{children:`You:  Make a logo for my app \"Wavelength\" — minimal, geometric\n\nClaude: [generates image]\n\nYou:  Love the shape, but make it monochrome and try a variation\n\nClaude: [generates new monochrome version + calls generate_variation on the original]`}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Programmatic (Python)\"}),q(M5,{children:[\"Build MCP into your app using the \",Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://github.com/jlowin/fastmcp\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"fastmcp\"}),\" client library:\"]}),Y(FQ,{children:`from fastmcp import Client\n\nasync with Client(\"https://mcp.midjourney.com/mcp\") as client:\n    result = await client.call_tool(\n        \"generate_image\",\n        {\"prompt\": \"minimalist logo, geometric shapes --ar 1:1\"}\n    )\n    # result contains preview image, job metadata, and CDN URL`}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Batch generation\"}),Y(FQ,{children:`import asyncio\nfrom fastmcp import Client\n\nasync def batch_generate(prompts: list[str]):\n    async with Client(\"https://mcp.midjourney.com/mcp\") as client:\n        tasks = [\n            client.call_tool(\"generate_image\", {\"prompt\": p})\n            for p in prompts\n        ]\n        return await asyncio.gather(*tasks)\n\nprompts = [\n    \"futuristic dashboard UI, dark theme --ar 16:9\",\n    \"nature-inspired dashboard UI, earth tones --ar 16:9\",\n    \"minimal dashboard UI, white space --ar 16:9\",\n    \"retro dashboard UI, 80s colors --ar 16:9\",\n]\nresults = asyncio.run(batch_generate(prompts))`})]})},{title:\"Troubleshooting\",body:q(a,{children:[Y(\"h3\",{className:\"mb-2 mt-1 text-[17px] text-white\",children:\"MCP connection fails / 403 after auth\"}),q(M5,{children:[\"You're likely authenticated with an account that doesn't have MCP access. Log out of midjourney.com, log back in with your \",Y(\"strong\",{className:\"text-white\",children:\"hackathon account\"}),\" (the one with the Mega plan), and retry the MCP connection.\"]}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"How do I know my account has MCP access?\"}),q(M5,{children:[\"Go to your account settings on midjourney.com. Your \",Y(\"strong\",{className:\"text-white\",children:\"Plan\"}),\" should show \",Y(\"strong\",{className:\"text-white\",children:\"Mega\"}),\" and the \",Y(\"strong\",{className:\"text-white\",children:\"Provider\"}),\" should match how you signed up. If not, you're on the wrong account.\"]}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Browser login keeps appearing\"}),Y(M5,{children:\"Make sure you're logging in with the same account that has an active subscription. Check that cookies aren't being blocked.\"}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"401 Unauthorized\"}),Y(M5,{children:\"Session expired — your client will automatically re-open the login flow. Sign in again.\"}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Job failed\"}),Y(M5,{children:\"Usually a content policy issue. Rephrase your prompt and try again.\"}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Generation is slow or queued\"}),Y(M5,{children:\"Your plan may have shifted to relax mode after using all fast GPU time. Generations still complete, just slower.\"}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"Client doesn't show the image\"}),Y(M5,{children:\"Not all MCP clients render inline images. Use the cdn_url from the response — paste it in a browser to view the full image.\"}),Y(\"h3\",{className:\"mb-2 mt-7 text-[17px] text-white\",children:\"503 Service Unavailable\"}),Y(M5,{children:\"Temporary server issue. Wait a few seconds and retry.\"})]})},{title:\"Resources\",body:q(\"ul\",{className:\"mb-4 list-disc space-y-1.5 pl-6\",children:[q(\"li\",{children:[Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://docs.midjourney.com\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"Midjourney Docs\"}),\" — full parameter reference, prompting guide, community guidelines\"]}),q(\"li\",{children:[Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://modelcontextprotocol.io\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"Model Context Protocol\"}),\" — MCP specification and client libraries\"]}),q(\"li\",{children:[Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://github.com/jlowin/fastmcp\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"fastmcp (Python)\"}),\" — Python MCP client library\"]}),q(\"li\",{children:[Y(\"a\",{className:\"text-[#8b7cff] hover:underline\",href:\"https://www.midjourney.com/explore\",target:\"_blank\",rel:\"noopener noreferrer\",children:\"Midjourney Explore\"}),\" — browse community creations for inspiration\"]})]})}];return q(a,{children:[Y(v0,