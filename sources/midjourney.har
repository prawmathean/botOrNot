Frame`,\"imagePrompts.dropToAddCharacter\":`Drop\nto add\nCharacter`,\"imagePrompts.dropToSwapSubject\":`Drop\nto swap\nSubject`,\"imagePrompts.selectImagesBelow\":`Select\nimages\nbelow`,\"imagePrompts.selectImageBelow\":`Select\nimage\nbelow`,\"imagePrompts.startingFrame\":\"Start Frame\",\"imagePrompts.startingFrameShort\":\"Start\",\"imagePrompts.extendVideo\":\"Extend Video\",\"imagePrompts.extendVideoShort\":\"Extend\",\"job.progress.percentComplete\":\"{percent}% Complete\",\"job.progress.queued\":\"Queued\",\"job.progress.cancelled\":\"Cancelled\",\"job.progress.submitting\":\"Submitting...\",\"job.progress.starting\":\"Starting...\",\"job.progress.reconnecting\":\"Trying to reconnect...\",\"job.progress.reconnectStalled\":\"Unable to reconnect. Try refreshing the page.\",\"imagePrompts.endingFrame\":\"End Frame\",\"imagePrompts.endingFrameShort\":\"End\",\"imagePrompts.imagePrompts\":\"Image Prompts\",\"imagePrompts.imagePromptsShort\":\"Images\",\"imagePrompts.styleReferences\":\"Style References\",\"imagePrompts.styleReferencesShort\":\"Styles\",\"imagePrompts.characterReferences\":\"Character References\",\"imagePrompts.characterReferencesShort\":\"Crefs\",\"imagePrompts.omniReference\":\"Omni Reference\",\"imagePrompts.omniReferenceShort\":\"Oref\",\"imagePrompts.animateAnImage\":\"Animate an image\",\"imagePrompts.makeVideoLonger\":\"Make a video longer\",\"imagePrompts.howAnimationEnds\":\"How the animation ends\",\"imagePrompts.useElementsOfImage\":\"Use the elements of an image\",\"imagePrompts.useStyleOfImage\":\"Use the style of an image\",\"imagePrompts.useCharacterLikeness\":\"Use a character's likeness\",\"imagePrompts.usePersonOrObjectForm\":\"Use a person's likeness, or an object's form\",\"imagePrompts.clickOrDragToAdd\":\"Click or drag to add\",\"imagePrompts.clickOrDragToSwap\":\"Click or drag to swap\",\"imagePrompts.unsupportedVersion\":\"Image prompts are not yet supported in version {version}\",\"imagePrompts.unavailableInDraftMode\":\"Unavailable in Draft mode\",\"imagePrompts.unavailableWithImagePrompts\":\"Unavailable with Image Prompts\",\"imagePrompts.unavailableWithVideo\":\"Unavailable with video\",\"imagePrompts.keepImagePrompts\":\"Keep Image Prompts\",\"imagePrompts.clearImagePrompts\":\"Clear Image Prompts\",\"imagePrompts.lockLabel\":\"Lock\",\"imagePrompts.removeAllLabel\":\"Clear\",\"imagePrompts.omniStrength\":\"Omni Strength\",\"settings.aspectRatio\":\"Aspect Ratio\",\"settings.image.portrait\":\"Portrait\",\"settings.image.square\":\"Square\",\"settings.image.landscape\":\"Landscape\",\"settings.aesthetics\":\"Aesthetics\",\"settings.model\":\"Model\",\"settings.model.mode\":\"Raw\",\"settings.model.mode.standard\":\"Standard\",\"settings.model.mode.raw\":\"Raw\",\"settings.model.version\":\"Version\",\"settings.model.version.standard\":\"Standard\",\"settings.model.version.draft\":\"Draft\",\"settings.version7Required\":\"V7 required in Draft mode\",\"settings.unlockPersonalization\":\"Unlock Personalization\",\"settings.unlockPersonalizationForNiji\":\"Unlock Personalization for Niji\",\"settings.syncError\":\"sync error\",\"settings.syncing\":\"syncing\",\"settings.tooltip.stylization.title\":\"Stylization\",\"settings.tooltip.stylization.text\":\"Influences how strongly the Midjourney aesthetic is applied. Low stylization values produce images that closely match the prompt but are less artistic. High stylization values create images that are very artistic but less connected to the prompt.\",\"settings.tooltip.weirdness.title\":\"Weirdness\",\"settings.tooltip.weirdness.text\":\"Introduces quirky qualities to your generated images, resulting in unique and unexpected outcomes.\",\"settings.tooltip.variety.title\":\"Variety\",\"settings.tooltip.variety.text\":\"Influences how varied the images are. High values will produce more unusual and unexpected results and compositions. Lower values have more reliable, repeatable results.\",\"settings.tooltip.mode.title\":\"Raw\",\"settings.tooltip.mode.text\":\"Raw replaces the default aesthetic of some Midjourney versions. Using it can help you create more photo-realistic images, cinematic scenes, or cuter characters.\",\"settings.tooltip.version.title\":\"Version\",\"settings.tooltip.version.text\":\"Midjourney routinely releases new model versions to improve efficiency, coherency, and quality. The latest version is the default, but each version excels at producing different types of images.\",\"settings.tooltip.personalize.title\":\"Personalize\",\"settings.tooltip.personalize.text\":\"Personalize your prompt based on images you've ranked. You can rank images in Tasks. This setting is only available on V6 or higher.\",\"settings.tooltip.speed.title\":\"Speed\",\"settings.tooltip.speed.text\":\"The speed at which images and videos generate.\",\"settings.tooltip.speed.relax.title\":\"Relax\",\"settings.tooltip.speed.relax.text\":\"Generates at a slower, variable rate, but won't spend Fast hours. Not available on the Basic Plan.\",\"settings.tooltip.speed.fast.title\":\"Fast\",\"settings.tooltip.speed.fast.text\":\"The default speed. Generates at a moderate rate and spends Fast hours.\",\"settings.tooltip.speed.turbo.title\":\"Turbo\",\"settings.tooltip.speed.turbo.text\":\"Generates at a much faster rate, but spends twice as many Fast hours.\",\"settings.tooltip.stealth.title\":\"Stealth\",\"settings.tooltip.stealth.text\":\"Enable this setting to prevent your images from being visible to others on the Explore page or your Profile page.\",\"settings.tooltip.videoResolution.title\":\"Video Resolution\",\"settings.tooltip.videoResolution.text\":\"The resolution of the video. Higher resolutions take longer to generate and cost more Fast hours.\",\"settings.tooltip.videoResolution.sd.title\":\"SD\",\"settings.tooltip.videoResolution.sd.text\":\"Default resolution (480p). Available on all plans.\",\"settings.tooltip.videoResolution.hd.title\":\"HD\",\"settings.tooltip.videoResolution.hd.text\":\"HD (720p) is available on the Standard, Pro, and Mega Plans.\",\"settings.tooltip.batchSize.title\":\"Video Batch Size\",\"settings.tooltip.batchSize.text\":\"Controls how many videos are generated in a single generation. Lower batch sizes cost fewer Fast hours.\",\"settings.tooltip.batchSize.one.text\":\"video per generation\",\"settings.tooltip.batchSize.two.text\":\"videos per generation\",\"settings.tooltip.batchSize.four.text\":\"videos per generation\",\"settings.tooltip.motion.title\":\"Motion\",\"settings.tooltip.motion.text\":'Controls how much movement is in the generated video. \"Low\" produces subtle, gentle motion, while \"High\" results in more dynamic movement.',\"settings.tooltip.motion.low.title\":\"Low\",\"settings.tooltip.motion.low.text\":\"Subtle, gentle motion\",\"settings.tooltip.motion.high.title\":\"High\",\"settings.tooltip.motion.high.text\":\"More dynamic, energetic motion\",\"settings.tooltip.length.title\":\"Length\",\"settings.tooltip.length.text\":\"Controls how long the generated video is\",\"settings.tooltip.length.short.title\":\"Short\",\"settings.tooltip.length.short.text\":\"2.5 second video\",\"settings.tooltip.length.medium.title\":\"Medium\",\"settings.tooltip.length.medium.text\":\"5 second video\",\"actions.tooltip.vary.title\":\"Vary\",\"actions.tooltip.vary.text\":\"Make images similar to this one, with slight changes.\",\"actions.tooltip.vary.params.subtle.title\":\"Subtle\",\"actions.tooltip.vary.params.subtle.text\":\"Makes minor changes to the image\",\"actions.tooltip.vary.params.strong.title\":\"Strong\",\"actions.tooltip.vary.params.strong.text\":\"Makes broader changes to the image\",\"actions.tooltip.upscale.title\":\"Upscale\",\"actions.tooltip.upscale.text\":\"Create a larger version of the image, ideal for sharing, saving, or printing.\",\"actions.tooltip.upscale_v5.params.2x.title\":\"2x\",\"actions.tooltip.upscale_v5.params.2x.text\":\"Creates an image that is double the size\",\"actions.tooltip.upscale_v5.params.4x.title\":\"4x\",\"actions.tooltip.upscale_v5.params.4x.text\":\"Creates an image that is four times the size\",\"actions.tooltip.upscale_v6.params.subtle.title\":\"Subtle\",\"actions.tooltip.upscale_v6.params.subtle.text\":\"Creates a larger copy, without changing the content\",\"actions.tooltip.upscale_v6.params.creative.title\":\"Creative\",\"actions.tooltip.upscale_v6.params.creative.text\":\"Creates a larger copy while adding more detail if needed. (May change the content)\",\"actions.tooltip.remix.title\":\"Remix\",\"actions.tooltip.remix.text\":\"Build upon this image by creating similar ones with a new or updated prompt.\",\"actions.tooltip.remix.params.subtle.title\":\"Subtle\",\"actions.tooltip.remix.params.subtle.text\":\"Smaller differences, for fine tuning an image\",\"actions.tooltip.remix.params.strong.title\":\"Strong\",\"actions.tooltip.remix.params.strong.text\":\"Larger differences, for moving in a new direction\",\"actions.tooltip.pan.title\":\"Pan\",\"actions.tooltip.pan.text\":\"Create wider or taller images by adding extra content in a specified direction.\",\"actions.tooltip.pan.params.directions.title\":\"Directions\",\"actions.tooltip.pan.params.directions.text\":\"The arrow points in the direction you want to create more content in\",\"actions.tooltip.zoom.title\":\"Zoom\",\"actions.tooltip.zoom.text\":\"Create a new image with extra content around the outside of the original.\",\"actions.tooltip.zoom.params.1_5x.title\":\"1.5x\",\"actions.tooltip.zoom.params.1_5x.text\":\"Expand the image to 1.5 times the size, maintaining the aspect ratio\",\"actions.tooltip.zoom.params.2x.title\":\"2x\",\"actions.tooltip.zoom.params.2x.text\":\"Same as 1.5x, but you can specify the zoom amount\",\"actions.tooltip.more.title\":\"More actions\",\"actions.tooltip.more.text\":\" \",\"actions.tooltip.more.params.rerun.title\":\"Rerun\",\"actions.tooltip.more.params.rerun.text\":\"Run the same prompt again\",\"actions.tooltip.more.params.enhance.title\":\"Enhance\",\"actions.tooltip.more.params.enhance.text\":\"Rerun a Draft job at full quality.\",\"actions.tooltip.more.params.editor.title\":\"Editor\",\"actions.tooltip.more.params.editor.text\":\"Edit specific parts of the image, with or without a prompt change\",\"actions.tooltip.use.title\":\"Use in prompt\",\"actions.tooltip.use.text\":\"Iterate, reference or riff off this creation by adding parts of it to your next prompt.\",\"actions.tooltip.use.params.image.title\":\"Image\",\"actions.tooltip.use.params.image.text\":\"Add to input as an Image Prompt\",\"actions.tooltip.use.params.style.title\":\"Style\",\"actions.tooltip.use.params.style.text\":\"Add to input as a Style Reference\",\"actions.tooltip.use.params.prompt.title\":\"Prompt\",\"actions.tooltip.use.params.prompt.text\":\"Copy the prompt into the Imagine bar\",\"actions.tooltip.video.auto.title\":\"Auto\",\"actions.tooltip.video.auto.text\":\"Create a video starting from this image\",\"actions.tooltip.video.manual.title\":\"Manual\",\"actions.tooltip.video.manual.text\":\"Create a video starting from this image with a prompt describing the motion\",\"actions.tooltip.video.params.low.title\":\"Low Motion\",\"actions.tooltip.video.params.low.text\":\"Create a video from this image with a low amount of motion\",\"actions.tooltip.video.params.high.title\":\"High Motion\",\"actions.tooltip.video.params.high.text\":\"Create a video from this image with a high amount of motion\",\"actions.tooltip.video.extend.auto.title\":\"Auto\",\"actions.tooltip.video.extend.auto.text\":\"Extend this video with the existing prompt\",\"actions.tooltip.video.extend.params.low.text\":\"Extend this video with a low amount of motion\",\"actions.tooltip.video.extend.params.high.text\":\"Extend this video with a high amount of motion\",\"actions.tooltip.video.extend.manual.title\":\"Manual\",\"actions.tooltip.video.extend.manual.text\":\"Extend this video with a new prompt\",\"actions.tooltip.video.loop.title\":\"Loop\",\"actions.tooltip.video.loop.text\":\"Create a video starting from this image that loops seamlessly\",\"actions.tooltip.video.loop.params.low.text\":\"Turn into a looping video, with a low level of motion\",\"actions.tooltip.video.loop.params.high.text\":\"Turn into a looping video, with a high level of motion\",\"moderation.pendingMessage\":\"You have a pending moderation message:\",\"moderation.reviewGuidelines\":\"Please review the Community Guidelines\",\"moderation.here\":\"here\",\"moderation.period\":\".\",\"moderation.communityStandards.title\":\"Community Guidelines\",\"error.pendingModerationMessage.title\":\"Pending Moderation Message\",\"moderation.allowed\":\"ALLOWED\",\"moderation.notAllowed\":\"NOT ALLOWED\",\"moderation.sfw\":\"Safe For Work (SFW) content.\",\"moderation.parodies\":\"Respectful or light-hearted parodies, satire, and caricatures using real images.\",\"moderation.fictional\":\"Fictional or exaggerated scenarios, including absurd or humorous situations.\",\"moderation.disrespectful\":\"Content that disrespects, harms, or misleads about public figures or events.\",\"moderation.hateSpeech\":\"Hate speech, explicit or real-world violence.\",\"moderation.nudity\":\"Nudity or overtly sexualized images.\",\"moderation.culturallyInsensitive\":\"Imagery that might be considered culturally insensitive.\",\"moderation.editorSystemNote\":\"Our AI system isn't perfect. Editor jobs have stricter filters, so some safe prompts may be blocked. Blocked jobs don't use your Fast hours.\",\"moderation.reportIncorrectBlocks\":\"Please report incorrect blocks in #ai-mod-bugs. Your feedback helps us improve our system.\",\"moderation.thanksForHelp\":\"Thank you for your help and patience!\",\"moderation.systemNotPerfect\":\"The AI system isn't perfect. If it blocks content you think is okay, let us know with the 'Notify Developers' button on the right. We'll check & improve our system using your feedback. Thank you for your help!\",\"moderation.fastHoursTitle\":\"Fast hours\",\"moderation.fastHoursDescription\":\"Fast hours are your prepaid monthly allowance for generating images and videos.\",\"moderation.fastHoursRefresh\":\"Fast hours refresh monthly with your subscription.\",\"error.queueFull.learnAboutLimits\":\"Learn about queue limits\",\"moderation.fastHoursViewRemaining\":\"You can view your remaining hours in your account settings\",\"moderation.fastHoursBuyMore\":\"You can always buy more if needed\",\"moderation.speeds\":\"Speeds:\",\"moderation.relaxSpeed\":\"Relax: No Fast hours are used. Only available on Standard Plan and higher.\",\"moderation.fastSpeed\":\"Fast: Each Fast hour will let you generate about 60 image jobs.\",\"moderation.turboSpeed\":\"Turbo: Faster, but uses double the Fast hours.\",\"moderation.turnOffRelax\":\"Turn off Relax\",\"moderation.turnOffStealth\":\"Turn off Stealth\",\"moderation.thankYouResubmit\":\"Thank you. Please resubmit your prompt.\",\"moderation.pendingModMessage\":\"You have a pending moderation message\",\"moderation.reviewMessage\":\"Review message\",\"error.allSetStartCreating\":\"You're all set, you can now start creating.\",\"error.rerunJob\":\"Rerun this job\",\"error.pleaseAcceptTermsToStartCreating\":\"Please accept the {terms} to start creating.\",\"error.completeCaptcha\":\"Please complete the captcha to continue.\",\"error.aiModerationCautious\":\"AI Moderation is cautious with realistic {type}, especially of people. Please try adjusting your prompt or trying a different idea.\",\"error.aiModerationVideos\":\"videos\",\"error.aiModerationImages\":\"images\",\"error.fastHoursExhausted\":\"You've run out of Fast hours. Please purchase more or switch to Relax mode to keep generating. Tap or hover to learn more.\",\"error.fastHoursExhaustedSwitch\":\"You've run out of Fast hours. Please purchase more or switch to Relax mode to keep generating. Tap or hover to learn more.\",\"error.fastHoursExhaustedSwitchSDVideo\":\"You've run out of Fast hours. Please purchase more or switch to Relax mode to generate unlimited SD videos. Tap or hover to learn more.\",\"error.fastHoursExhaustedOnHDVideo\":\"You've run out of Fast hours. Please purchase more or switch to SD to generate unlimited videos with Relax mode. Tap or hover to learn more.\",\"error.fastHoursExhaustedUpgrade\":\"You've run out of Fast hours. Please purchase more, or upgrade to the Standard Plan for unlimited images in Relax mode. Tap or hover to learn more.\",\"error.fastHoursExhaustedUpgradeVideo\":\"You've run out of Fast hours. Please purchase more, or upgrade to the Pro Plan for unlimited SD videos in Relax mode. Tap or hover to learn more.\",\"error.viewSubscriptionPlans\":\"View plans\",\"error.noPrompt\":\"Please enter a prompt or wait for your jobs to load to try a style.\",\"modal.usernames.title\":\"It's time to choose your name!\",\"modal.usernames.section.description\":\"Set a unique, public username to make it easier for you and others to find your creations.\",\"modal.usernames.section.description_2\":\"It also helps our community feel more like a community.\",\"modal.usernames.section.description_3\":\"The earlier you claim it, the less likely it is to be taken by someone else, so get in early!\",\"modal.usernames.section.description_4\":\"And don't worry, you can always change it later.\",\"modal.usernames.section.description.profileUrl\":\"Your profile URL:\",\"modal.usernames.cta\":\"Claim Your Username\",\"fromIdPage.profile.redirecting\":\"Loading Profile...\",\"fromIdPage.profile.userNotFound\":\"Member not found\",\"fromIdPage.profile.userHasNotSetupProfile\":\"This member has not set up a public profile yet\",\"toast.dismiss\":\"Dismiss\",\"editor.openInEditor\":\"Open in Editor\",\"styleRefiner.title\":\"Style Creator\",\"styleRefiner.description\":'Select the styles you like most from the grid and click \"Create Style\"',\"styleRefiner.description2\":\"With each step we will make a new image and a new style-code that gets closer to your perfect aesthetic.\",\"styleRefiner.description3\":\"You can re-use any custom style code on any future job after this process.\",\"styleRefiner.descriptionIterations\":\"It will take around <strong>5</strong> iterations for your style to stabilize, then you'll notice a lot of refinement from <strong>5 to 15</strong>, then <strong>past 15</strong> it's all about nuance.\",\"styleRefiner.description4.start\":\"To get started\",\"styleRefiner.description5\":' select at least one style in the grid or click \"Skip\" to see more starter styles.',\"styleRefiner.findingStyles\":\"Finding Styles...\",\"styleRefiner.originalShort\":\"OG\",\"styleCreator.welcomeTitle\":\"Welcome to the Style Creator\",\"styleCreator.styleCreatorUnsupported\":\"The Style Creator is currently unsupported\",\"styleCreator.creationReel.previewing\":\"Previewing...\",\"styleCreator.creationReel.skipping\":\"Skipping...\",\"styleCreator.creationReel.hint.selectAndScrollToRefine\":\"Select Images & Scroll to Refine your style\",\"styleCreator.creationReel.selectionSummary\":\"{count, plural, =0 {No New<br></br>Selections} one {# New<br></br>Selection} other {# New<br></br>Selections}}\",\"styleCreator.creationReel.changesSummary\":\"{count, plural, =0 {No<br></br>Changes} one {# <br></br>Change} other {# <br></br>Changes}}\",\"styleCreator.creationReel.scrollToSkip\":\"Scroll to Skip\",\"styleCreator.creationReel.scrollToRefine\":\"Scroll to Refine\",\"styleCreator.creationReel.pinPreviewLabel\":\"Pin<br></br>Preview\",\"styleCreator.creationReel.unpinPreviewLabel\":\"Unpin<br></br>Preview\",\"styleCreator.idealMinimum.label\":\"IDEAL MINIMUM\",\"styleCreator.idealMinimum.tooltip\":\"For best results, we recommend completing at least five rounds.\",\"styleCreator.bookEnd.hotkeyContinueToLoadMore\":\"Continue to next line to Load More\",\"styleCreator.bookEnd.scrollToLoadMore\":\"Scroll to Load more\",\"styleCreator.hotkeys.enable\":\"Enable Hotkeys\",\"styleCreator.hotkeys.disable\":\"Disable Hotkeys\",\"styleCreator.autoPreviews.enable\":\"Enable Automatic Previews\",\"styleCreator.autoPreviews.disable\":\"Disable Automatic Previews\",\"styleCreator.session.reset\":\"Reset Session\",\"styleCreator.session.end\":\"End Session\",\"styleCreator.start\":\"Start\",\"styleCreator.landing.description\":\"Type a prompt and hit start. Select images that match your vision. Your unique style evolves with each choice.\",\"styleCreator.landing.selectedStyle\":\"Selected style\",\"styleCreator.landing.startWithStyle\":\"Have a direction in mind? Start with a style\",\"styleCreator.landing.searchResults\":\"Search results\",\"styleCreator.landing.continueFromPrompt\":\"Or continue from a recent prompt\",\"styleCreator.landing.noStylesFound\":\"No styles found\",\"styleCreator.confirmNewSession.title\":\"Start New Session?\",\"styleCreator.confirmNewSession.body\":\"Starting a new Style Creator session will end your current one.\",\"styleCreator.confirmNewSession.confirm\":\"Start New Session\",\"styleCreator.confirmNewSession.cancel\":\"Keep Current Session\",\"styleCreator.feedType.liked\":\"Liked\",\"styleCreator.feedType.topDay\":\"Top Day\",\"styleCreator.feedType.recentlyUsed\":\"Recently Used\",\"styleCreator.feedType.topWeek\":\"Top Week\",\"styleCreator.feedType.topMonth\":\"Top Month\",\"Version selection not available\":\"Version selection not available\",\"Debug Options\":\"Debug Options\",styleScrollerTutorial_1:\"Scroll the page, selecting any image that matches your target style.\",styleScrollerTutorial_2:\"As you scroll and select, the styles on display will grow closer to your target.\",styleScrollerTutorial_3:\"Track your custom style's progress by viewing the preview jobs on the right.\",styleScrollerTutorial_4:\"Continue refining your style until you find the perfect one.\",\"Find the perfect style for your prompt in a few, simple steps:\":\"Find the perfect style for your prompt in a few, simple steps:\",\"error.common.creationFailed\":\"Creation failed\",\"error.subs