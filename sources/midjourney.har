tagecore and Regencycore aesthetic, vintage stationery feel, English countryside charm, soft pastel palette with warm summer tones, premium commercial clipart quality, highly detailed, crisp edges, centered, isolated on pure white background, no scene, no shadows, no borders, no text.\",\"weight\":1}],\"params\":null,\"version\":\"8.1\",\"quality\":null,\"tile\":false,\"styleRaw\":false,\"styleRef\":[],\"personalize\":[{\"content\":\"e9hifnd\",\"weight\":1}],\"pv\":null,\"sv\":null,\"sw\":null,\"depthRef\":[],\"dw\":null,\"stylize\":null,\"weird\":null,\"imageWeight\":null,\"video\":false,\"draft\":false,\"hd\":true,\"preview\":false,\"av\":null},\"published\":true,\"items\":[{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":true},{\"filtered\":false,\"actions\":{},\"server_filtered\":false}],\"owner_profile\":null,\"type\":\"image\",\"video_segments\":null},{\"isFeedJob\":true,\"id\":\"1a7eefc2-69b7-4491-acde-477c6a7ae158\",\"job_type\":\"v8-1_diffusion\",\"event_type\":\"diffusion\",\"enqueue_time\":1783919344023,\"parent_grid\":null,\"parent_id\":null,\"width\":1024,\"height\":1024,\"username_v2\":\"u8925648182\",\"display_name\":\"u8925648182\",\"user_id\":\"5bd94328-fd90-4f27-8e44-e45c2943cdd7\",\"prompt\":{\"no\":[],\"images\":[],\"stop\":null,\"chaos\":null,\"ar\":null,\"seed\":null,\"speed\":null,\"visibility\":null,\"batchSize\":null,\"exp\":null,\"sd\":false,\"decodedPrompt\":[{\"content\":\"hip puppy\",\"weight\":1}],\"params\":null,\"version\":\"8.1\",\"quality\":null,\"tile\":false,\"styleRaw\":false,\"styleRef\":[{\"t\":\"url\",\"content\":\"https://s.mj.run/-T-OeKTkoqw\",\"weight\":1},{\"t\":\"url\",\"content\":\"https://s.mj.run/byU_0oBTG00\",\"weight\":1}],\"personalize\":[{\"content\":\"m8nxp3d\",\"weight\":1}],\"pv\":null,\"sv\":null,\"sw\":null,\"depthRef\":[],\"dw\":null,\"stylize\":null,\"weird\":null,\"imageWeight\":nu