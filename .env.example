# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains your admin password and session secret.

# ─────────────────────────────────────────────
# Admin password for the /admin dashboard.
# Keep it simple — this is a closed LAN event.
# ─────────────────────────────────────────────
ADMIN_PASSWORD=changeme

# ─────────────────────────────────────────────
# Secret used to sign the admin session cookie.
# Generate one with: npm run generate-secret
# ─────────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────────
# Optional: change the port (default: 6767)
# ─────────────────────────────────────────────
# PORT=6767
