{
  "name": "bot-or-not",
  "version": "1.0.0",
  "description": "LAN-hosted image guessing game — can participants tell AI-generated images from real ones?",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build-manifest": "node scripts/build-manifest.js",
    "build-manifest-force": "node scripts/build-manifest.js --force",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
